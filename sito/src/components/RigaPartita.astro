---
/* Una riga di calendario: orario, squadre, quote, e la lettura del modello.
   In HTML e non in SVG: il testo dentro le barre non si deve deformare. */

interface Props {
  p: any;
  slug: string;
  mostraData?: boolean;
}
const { p, slug, mostraData = false } = Astro.props;

const num = (v: number, d = 2) =>
  v.toLocaleString("it-IT", { minimumFractionDigits: d, maximumFractionDigits: d });
const pct = (v: number, d = 0) => num(v * 100, d) + "%";

const giorno = new Date(p.data + "T00:00:00");
const colori = ["var(--s1)", "var(--s2)", "var(--s3)"];
const etichette = ["1", "X", "2"];
const quote = p.quote.massimo ?? p.quote.media ?? p.quote.bet365 ?? null;
---

<a class="riga-partita" href={`/calcio/${slug}/${p.id}/`}>
  <div class="quando">
    {
      mostraData && (
        <b>{giorno.toLocaleDateString("it-IT", { day: "2-digit", month: "short" })}</b>
      )
    }
    <span class="mono">{p.ora || "—"}</span>
  </div>

  <div class="chi">
    {p.casa} <i>—</i> {p.ospite}
  </div>

  <div class="prob">
    {
      p.p_modello ? (
        <div class="barra">
          {p.p_modello.map((x: number, i: number) => (
            <span
              class="seg"
              style={`width:${x * 100}%;background:${colori[i]}`}
              title={`${etichette[i]}: modello ${pct(x, 1)}${
                p.p_mercato ? `, mercato ${pct(p.p_mercato[i], 1)}` : ""
              }`}
            >
              {x > 0.12 && <em>{etichette[i]} {Math.round(x * 100)}</em>}
            </span>
          ))}
        </div>
      ) : (
        <span class="assente">squadra senza storico</span>
      )
    }
  </div>

  <div class="quote mono">
    {
      quote ? (
        quote.map((q: number, i: number) => (
          <span>
            <i>{etichette[i]}</i>
            {num(q)}
          </span>
        ))
      ) : (
        <span class="assente">—</span>
      )
    }
  </div>

  <div class="margine mono">
    {p.margine !== null ? pct(p.margine, 1) : "—"}
  </div>
</a>

<style>
  .riga-partita {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr) 190px 210px 62px;
    gap: 16px;
    align-items: center;
    padding: 12px 18px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
  }
  .riga-partita:last-child {
    border-bottom: 0;
  }
  .riga-partita:hover {
    background: var(--sunk);
  }

  .quando {
    font-size: 12px;
    color: var(--ink-3);
    line-height: 1.35;
  }
  .quando b {
    display: block;
    color: var(--ink-2);
    font-weight: 600;
    text-transform: lowercase;
  }

  .chi {
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.3;
    min-width: 0;
  }
  .chi i {
    font-style: normal;
    color: var(--ink-3);
    font-weight: 400;
    margin: 0 3px;
  }

  .barra {
    display: flex;
    height: 22px;
    gap: 2px;
  }
  .seg {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-width: 0;
  }
  .seg em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 10.5px;
    color: #fff;
    white-space: nowrap;
  }

  .quote {
    display: flex;
    gap: 6px;
    font-size: 12.5px;
  }
  .quote span {
    display: flex;
    align-items: baseline;
    gap: 5px;
    border: 1px solid var(--rule);
    padding: 3px 8px;
    flex: 1;
    justify-content: center;
  }
  .quote i {
    font-style: normal;
    color: var(--ink-3);
    font-size: 10.5px;
  }

  .margine {
    text-align: right;
    font-size: 13px;
    color: var(--ink-2);
  }
  .assente {
    font-size: 12px;
    color: var(--ink-3);
    font-family: var(--sans);
  }

  @media (max-width: 1000px) {
    .riga-partita {
      grid-template-columns: 64px minmax(0, 1fr) 150px;
      row-gap: 10px;
    }
    .quote,
    .margine {
      grid-column: 2 / -1;
    }
    .margine {
      text-align: left;
    }
  }
  @media (max-width: 700px) {
    .riga-partita {
      grid-template-columns: 1fr;
    }
    .quote,
    .margine {
      grid-column: 1;
    }
  }
</style>
