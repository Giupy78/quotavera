---
/* La tabella dei risultati esatti. Rampa a una sola tinta, chiaro -> scuro:
   e' una grandezza, non delle categorie, quindi niente arcobaleno. */

interface Props {
  matrice: number[][];
  casa: string;
  ospite: string;
  n?: number;
}

const { matrice, casa, ospite, n = 5 } = Astro.props;

const cella = 62;
const padL = 44;
const padT = 30;
const W = padL + cella * n;
const H = padT + cella * n + 22;

let max = 0;
for (let i = 0; i < n; i++)
  for (let j = 0; j < n; j++) max = Math.max(max, matrice[i][j]);

/* La rampa si costruisce con color-mix sui token, cosi' segue il tema
   chiaro/scuro senza dover ricalcolare niente lato client. */
const celle = [];
for (let i = 0; i < n; i++) {
  for (let j = 0; j < n; j++) {
    const p = matrice[i][j];
    const t = Math.pow(p / max, 0.62);
    celle.push({
      i,
      j,
      p,
      x: padL + j * cella,
      y: padT + i * cella,
      riempimento: `color-mix(in srgb, var(--ramp-1) ${(t * 100).toFixed(1)}%, var(--ramp-0))`,
      testo: t > 0.55 ? "#ffffff" : "var(--ink-2)",
      chi: i > j ? casa : i === j ? "pareggio" : ospite,
    });
  }
}
---

<svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label="Probabilità di ogni risultato esatto">
  {
    celle.map((c) => (
      <g>
        <rect
          x={c.x + 1}
          y={c.y + 1}
          width={cella - 2}
          height={cella - 2}
          fill={c.riempimento}
          stroke="var(--card)"
          stroke-width="2"
        >
          <title>
            {c.i}-{c.j}: {(c.p * 100).toFixed(1)}% — quota equa {(1 / c.p).toFixed(2)} — {c.chi}
          </title>
        </rect>
        <text
          x={c.x + cella / 2}
          y={c.y + cella / 2 + 4}
          text-anchor="middle"
          font-size="12"
          font-family="IBM Plex Mono, monospace"
          fill={c.testo}
        >
          {(c.p * 100).toFixed(1)}
        </text>
      </g>
    ))
  }
  {
    Array.from({ length: n }, (_, j) => (
      <text
        x={padL + j * cella + cella / 2}
        y={padT - 10}
        text-anchor="middle"
        fill="var(--ink-3)"
        font-size="12"
        font-family="IBM Plex Mono, monospace"
      >
        {j}
      </text>
    ))
  }
  {
    Array.from({ length: n }, (_, i) => (
      <text
        x={padL - 12}
        y={padT + i * cella + cella / 2 + 4}
        text-anchor="end"
        fill="var(--ink-3)"
        font-size="12"
        font-family="IBM Plex Mono, monospace"
      >
        {i}
      </text>
    ))
  }
  <text x={padL} y={H - 4} fill="var(--ink-3)" font-size="11">
    reti {ospite} →    ↓ reti {casa}    ·  valori in %
  </text>
</svg>
