---
/* Il profitto cumulato in unita' di puntata, discese comprese.
   Si disegna il profitto e non il rendimento perche' il rendimento e' un
   rapporto: dopo la prima giocata persa vale -100%, e l'asse diventa
   illeggibile. Il rendimento finale sta scritto come numero, dove serve. */

interface Props {
  curva: number[];
  ribasso?: number;
}
const { curva, ribasso } = Astro.props;

const W = 460,
  H = 320,
  L = 52,
  R = 18,
  T = 14,
  B = 42;
const iw = W - L - R;
const ih = H - T - B;

const min = Math.min(...curva);
const max = Math.max(...curva);
const span = Math.max(max - min, 4);
const passo = span > 40 ? 10 : span > 16 ? 5 : 2;
const y0 = Math.floor(min / passo) * passo - passo / 2;
const y1 = Math.ceil(max / passo) * passo + passo / 2;

const x = (i: number) => L + (i / Math.max(curva.length - 1, 1)) * iw;
const y = (v: number) => T + ih - ((v - y0) / (y1 - y0)) * ih;

const tacche: number[] = [];
for (let v = Math.ceil(y0 / passo) * passo; v <= y1 + 1e-9; v += passo) tacche.push(v);

const punti = curva.map((v, i) => `${x(i).toFixed(2)},${y(v).toFixed(2)}`);
const area = `M${x(0)},${y(0)} L${punti.join(" L")} L${x(curva.length - 1)},${y(0)} Z`;
const linea = `M${punti.join(" L")}`;
const ultimo = curva.length - 1;
const finale = curva[ultimo];
const positivo = finale >= 0;
const tinta = positivo ? "var(--good)" : "var(--s2)";
const passi = [0, Math.round(ultimo / 4), Math.round(ultimo / 2), Math.round((3 * ultimo) / 4), ultimo];
---

<svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label="Profitto cumulato sulle giocate di valore">
  <g class="griglia">
    {tacche.map((v) => <line x1={L} y1={y(v)} x2={W - R} y2={y(v)} />)}
  </g>

  <line x1={L} y1={y(0)} x2={W - R} y2={y(0)} stroke="var(--ink-3)" stroke-width="1.5" />

  <path d={area} fill={tinta} fill-opacity="0.10" />
  <path d={linea} fill="none" stroke={tinta} stroke-width="2" stroke-linejoin="round" />

  <circle cx={x(ultimo)} cy={y(finale)} r="4.5" fill={tinta} stroke="var(--card)" stroke-width="2" />
  <text
    x={x(ultimo) - 9}
    y={y(finale) + (positivo ? -12 : 18)}
    text-anchor="end"
    fill={tinta}
    font-size="13"
    font-weight="600"
    font-family="IBM Plex Mono, monospace"
  >
    {positivo ? "+" : ""}{finale.toFixed(1)}
  </text>

  <g class="assi">
    <line x1={L} y1={T} x2={L} y2={T + ih} />
    <line x1={L} y1={y(0)} x2={W - R} y2={y(0)} />
    {
      tacche.map((v) => (
        <text x={L - 8} y={y(v) + 4} text-anchor="end">
          {v > 0 ? "+" : ""}{v}
        </text>
      ))
    }
    {
      passi.map((i) => (
        <text x={x(i)} y={H - B + 17} text-anchor="middle">
          {i}
        </text>
      ))
    }
  </g>
  <text x={L + iw / 2} y={H - 5} text-anchor="middle" class="etichetta">
    giocate {ribasso !== undefined && `· peggior discesa ${ribasso.toFixed(1)} unità`}
  </text>
  <text x={-(T + ih / 2)} y="13" text-anchor="middle" class="etichetta" transform="rotate(-90)">
    profitto (unità di puntata)
  </text>
</svg>
