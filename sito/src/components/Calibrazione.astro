---
/* Il grafico che nessun sito di pronostici pubblica: dichiarato contro
   osservato. Sulla diagonale il modello dice la verita' sulla propria
   incertezza. Il cerchio cresce con il numero di casi nella fascia. */

interface Fascia {
  centro: number;
  dichiarata: number;
  osservata: number;
  casi: number;
}
interface Props {
  fasce: Fascia[];
}

const { fasce } = Astro.props;

const W = 460,
  H = 320,
  L = 48,
  R = 16,
  T = 14,
  B = 42;
const iw = W - L - R;
const ih = H - T - B;
const x = (v: number) => L + v * iw;
const y = (v: number) => T + ih - v * ih;

const punti = fasce.map((f) => `${x(f.dichiarata)},${y(f.osservata)}`).join(" ");
const tacche = [0, 0.25, 0.5, 0.75, 1];
---

<svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label="Curva di calibrazione del modello">
  <g class="griglia">
    {tacche.map((v) => <line x1={L} y1={y(v)} x2={W - R} y2={y(v)} />)}
  </g>

  <line
    x1={x(0)}
    y1={y(0)}
    x2={x(1)}
    y2={y(1)}
    stroke="var(--ink-3)"
    stroke-width="1.5"
    stroke-dasharray="4 4"
  />

  <polyline points={punti} fill="none" stroke="var(--s1)" stroke-width="2" stroke-linejoin="round" />

  {
    fasce.map((f) => (
      <circle
        cx={x(f.dichiarata)}
        cy={y(f.osservata)}
        r={Math.max(4, Math.sqrt(f.casi) / 3.2)}
        fill="var(--s1)"
        stroke="var(--card)"
        stroke-width="2"
      >
        <title>
          Fascia {Math.round(f.centro * 100)}%: dichiarato {(f.dichiarata * 100).toFixed(1)}%,
          osservato {(f.osservata * 100).toFixed(1)}% su {f.casi} casi
        </title>
      </circle>
    ))
  }

  <g class="assi">
    <line x1={L} y1={y(0)} x2={W - R} y2={y(0)} />
    <line x1={L} y1={T} x2={L} y2={y(0)} />
    {
      tacche.map((v) => (
        <>
          <text x={x(v)} y={H - B + 17} text-anchor="middle">
            {Math.round(v * 100)}
          </text>
          <text x={L - 8} y={y(v) + 4} text-anchor="end">
            {Math.round(v * 100)}
          </text>
        </>
      ))
    }
  </g>
  <text x={L + iw / 2} y={H - 5} text-anchor="middle" class="etichetta">
    probabilità dichiarata (%)
  </text>
  <text x={-(T + ih / 2)} y="13" text-anchor="middle" class="etichetta" transform="rotate(-90)">
    frequenza osservata (%)
  </text>
</svg>
