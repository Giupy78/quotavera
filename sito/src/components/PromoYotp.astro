---
/* Banner di You On The Pitch (youonthepitch.com), l'altro progetto di chi fa
   Quota Vera: partite amatoriali vicino a te. Non e' gioco con vincita in
   denaro, quindi il decreto dignita' non c'entra; e' dichiarato come
   promozione di un nostro progetto, non mascherato da contenuto.
   Forme: "largo" in fondo a ogni pagina, "riga" dentro gli articoli, "top" sotto
   il menu, "lato" nelle colonne fisse a destra e sinistra (solo schermi larghi,
   dove ai lati della pagina c'e' spazio vuoto: non coprono mai il contenuto).
   Il parametro utm dice al sito d'arrivo da dove arrivano le visite. */
interface Props {
  forma?: "largo" | "riga" | "top" | "lato";
  lato?: "sx" | "dx";
  dove?: string;
}
const { forma = "largo", lato = "sx", dove = "pagina" } = Astro.props;
const link = `https://youonthepitch.com/?utm_source=quotavera&utm_medium=banner&utm_campaign=crosspromo&utm_content=${dove}`;
---
{forma === "top" ? (
  <aside class="yotp-top" aria-label="You On The Pitch, un altro nostro progetto">
    <img src="/promo/yotp-logo.png" width="24" height="24" alt="" />
    <p><b>You On The Pitch</b> · Trova la partita vicino a te a cui manca un giocatore: calcetto, basket, volley, padel, tennis. Gratis.</p>
    <a href={link} target="_blank" rel="noopener">Gioca stasera →</a>
  </aside>
) : forma === "lato" ? (
  <aside class={`yotp-lato yotp-${lato}`} aria-label="You On The Pitch, un altro nostro progetto">
    <a href={link} target="_blank" rel="noopener">
      <img class="yotp-lato-img" src="/promo/yotp-sport.webp" width="900" height="502" loading="lazy" decoding="async" alt="" />
      <span class="yotp-lato-txt">
        <span class="yotp-kick">Un nostro progetto</span>
        {lato === "sx" ? (
          <b>Ti manca uno per il calcetto?</b>
        ) : (
          <b>Organizzi un torneo con gli amici?</b>
        )}
        <span>{lato === "sx" ? "Trova giocatori vicino a te in un tocco." : "Gironi, tabellone e calendario in due minuti."}</span>
        <span class="yotp-lato-btn"><img src="/promo/yotp-logo.png" width="18" height="18" alt="" /> You On The Pitch →</span>
      </span>
    </a>
  </aside>
) : forma === "largo" ? (
  <aside class="yotp" aria-label="You On The Pitch, un altro nostro progetto">
    <a class="yotp-img" href={link} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
      <img src="/promo/yotp-sport.webp" width="900" height="502" loading="lazy" decoding="async"
        alt="" />
    </a>
    <div class="yotp-txt">
      <span class="yotp-kick">Un altro progetto di chi fa Quota Vera</span>
      <p class="yotp-tit">Le partite le analizzi. E se stasera giocassi tu?</p>
      <p>
        <b>You On The Pitch</b> trova vicino a te la partita a cui manca un giocatore:
        calcetto, calcio, basket, volley, beach volley, padel e tennis. Squadre,
        tornei con il tabellone e la tua carta giocatore. Gratis, senza pubblicità.
      </p>
      <a class="yotp-btn" href={link} target="_blank" rel="noopener">
        <img src="/promo/yotp-logo.png" width="22" height="22" alt="" />
        Trova una partita vicino a te →
      </a>
    </div>
  </aside>
) : (
  <aside class="yotp-riga" aria-label="You On The Pitch, un altro nostro progetto">
    <img src="/promo/yotp-logo.png" width="36" height="36" alt="" />
    <p>
      <b>Dalle statistiche al campo.</b> Con You On The Pitch trovi la partita di calcetto,
      basket, volley o padel a cui manca un giocatore, vicino a te.
    </p>
    <a href={link} target="_blank" rel="noopener">Provala gratis →</a>
  </aside>
)}

<style>
  .yotp-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 14px 0 0;
    padding: 8px 14px;
    border-radius: 10px;
    background: linear-gradient(90deg, #2a0447, #4a0377);
    color: #f1f4f8;
    font-family: var(--sans);
    font-size: 13px;
  }
  .yotp-top img {
    border-radius: 5px;
    flex: none;
  }
  .yotp-top p {
    flex: 1;
    margin: 0;
    min-width: 0;
    line-height: 1.4;
  }
  .yotp-top a {
    flex: none;
    color: #ffb547;
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .yotp-top p {
      font-size: 12px;
    }
  }

  /* Colonne laterali: fisse, larghe 140px, solo dove ai lati della pagina
     (larga 1080px) resta spazio libero. */
  .yotp-lato {
    display: none;
  }
  @media (min-width: 1400px) {
    .yotp-lato {
      display: block;
      position: fixed;
      top: 150px;
      width: 140px;
      z-index: 5;
      font-family: var(--sans);
    }
    .yotp-sx {
      left: calc(50% - 540px - 160px);
    }
    .yotp-dx {
      right: calc(50% - 540px - 160px);
    }
  }
  .yotp-lato a {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(170deg, #2a0447, #12061f 80%);
    color: #f1f4f8;
    text-decoration: none;
    box-shadow: inset 0 0 0 1px rgba(181, 123, 224, 0.25);
  }
  .yotp-lato a:hover {
    box-shadow: inset 0 0 0 1px #ff8a5f;
  }
  .yotp-lato-img {
    display: block;
    width: 100%;
    height: 170px;
    object-fit: cover;
  }
  .yotp-dx .yotp-lato-img {
    object-position: 85% 50%;
  }
  .yotp-sx .yotp-lato-img {
    object-position: 15% 50%;
  }
  .yotp-lato-txt {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 12px 14px;
    font-size: 12.5px;
    line-height: 1.4;
  }
  .yotp-lato-txt b {
    font-size: 15px;
    line-height: 1.25;
    color: #fff;
  }
  .yotp-lato-txt > span:not(.yotp-kick):not(.yotp-lato-btn) {
    color: rgba(241, 244, 248, 0.82);
  }
  .yotp-lato-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    padding: 8px;
    border-radius: 8px;
    background: #ff6e42;
    color: #1a0a04;
    font-weight: 700;
    font-size: 12px;
  }
  .yotp-lato-btn img {
    border-radius: 4px;
  }

  .yotp {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    margin-top: 48px;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(150deg, #2a0447, #12061f 75%);
    color: #f1f4f8;
    box-shadow: inset 0 0 0 1px rgba(181, 123, 224, 0.25);
  }
  .yotp-img {
    display: block;
    line-height: 0;
  }
  .yotp-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 220px;
  }
  .yotp-txt {
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
    font-family: var(--sans);
  }
  .yotp-kick {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffb547;
  }
  .yotp-tit {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
  }
  .yotp p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(241, 244, 248, 0.86);
  }
  .yotp .yotp-tit {
    color: #fff;
  }
  .yotp-btn {
    align-self: flex-start;
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 10px;
    background: #ff6e42;
    color: #1a0a04;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
  }
  .yotp-btn:hover {
    background: #ff8a5f;
  }
  .yotp-btn img {
    border-radius: 5px;
  }
  @media (max-width: 720px) {
    .yotp {
      grid-template-columns: 1fr;
    }
    .yotp-img img {
      min-height: 0;
      aspect-ratio: 900 / 502;
    }
    .yotp-txt {
      padding: 18px 16px 20px;
    }
    .yotp-btn {
      align-self: stretch;
      justify-content: center;
    }
  }

  .yotp-riga {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 32px 0;
    padding: 14px 16px;
    border: 1px solid var(--rule);
    border-left: 4px solid #8e4ea8;
    border-radius: 10px;
    background: var(--card);
    font-family: var(--sans);
  }
  .yotp-riga img {
    border-radius: 8px;
    flex: none;
  }
  .yotp-riga p {
    flex: 1 1 260px;
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .yotp-riga a {
    font-weight: 700;
    font-size: 14px;
    color: var(--s3);
    white-space: nowrap;
  }
</style>
