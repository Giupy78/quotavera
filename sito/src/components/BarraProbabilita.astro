---
/* La barra 1X2: pieno = modello, tacca verticale = mercato.
   In HTML e non in SVG. In SVG servirebbe preserveAspectRatio="none" per far
   riempire la larghezza disponibile, e quello stira il testo in orizzontale:
   le etichette diventano illeggibili. Con flex e percentuali il testo resta
   testo, e la barra si adatta lo stesso. */

interface Esito {
  esito: string;
  p_modello: number;
  p_mercato: number;
}
interface Props {
  esiti: Esito[];
  compatta?: boolean;
}

const { esiti, compatta = false } = Astro.props;
const colori = ["var(--s1)", "var(--s2)", "var(--s3)"];

let cumulata = 0;
const tacche = esiti.slice(0, -1).map((e) => {
  cumulata += e.p_mercato;
  return cumulata;
});

const pct = (v: number) => (v * 100).toLocaleString("it-IT", { maximumFractionDigits: 1 });
---

<div class:list={["barra", { compatta }]}>
  {
    esiti.map((e, i) => (
      <div
        class="seg"
        style={`width:${e.p_modello * 100}%;background:${colori[i]}`}
        title={`${e.esito} — modello ${pct(e.p_modello)}%, mercato ${pct(e.p_mercato)}%`}
      >
        {e.p_modello > 0.09 && (
          <span class="et">
            <b>{e.esito}</b>
            {Math.round(e.p_modello * 100)}
          </span>
        )}
      </div>
    ))
  }
  {tacche.map((t) => <i class="tacca" style={`left:${t * 100}%`} />)}
</div>

<style>
  .barra {
    position: relative;
    display: flex;
    height: 26px;
    gap: 2px;
    isolation: isolate;
  }
  .barra.compatta {
    height: 20px;
  }

  .seg {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    overflow: hidden;
  }

  .et {
    display: flex;
    align-items: baseline;
    gap: 5px;
    font-family: var(--mono);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
    color: #fff;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }
  .barra.compatta .et {
    font-size: 10.5px;
  }
  .et b {
    font-weight: 600;
    opacity: 0.72;
  }

  /* La tacca del mercato: sporge sopra e sotto la barra, così si vede anche
     quando cade dentro un segmento scuro. */
  .tacca {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 2px;
    margin-left: -1px;
    background: var(--ink);
    z-index: 2;
  }
</style>
