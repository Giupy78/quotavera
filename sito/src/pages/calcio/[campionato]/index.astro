---
import Base from "../../../layouts/Base.astro";
import RigaPartita from "../../../components/RigaPartita.astro";
import campionati from "../../../dati/campionati.json";
import calendario from "../../../dati/calendario.json";
import squadre from "../../../dati/squadre.json";
import classifiche from "../../../dati/classifiche.json";
import risultati from "../../../dati/risultati.json";
import stagione from "../../../dati/stagione.json";

export function getStaticPaths() {
  const cal = calendario.campionati as Record<string, any[]>;
  const sq = squadre.campionati as Record<string, any[]>;
  const cl = classifiche.campionati as Record<string, any[]>;
  const ri = risultati.campionati as Record<string, any[]>;
  return campionati.campionati.map((c) => ({
    params: { campionato: c.slug },
    props: {
      lega: c,
      partite: cal[c.slug] ?? [],
      team: sq[c.slug] ?? [],
      classifica: cl[c.slug] ?? [],
      ultimi: ri[c.slug] ?? [],
      completo: (stagione.campionati as Record<string, any>)[c.slug] ?? null,
    },
  }));
}

const { lega, partite, team, classifica, ultimi, completo } = Astro.props;

/* Gli id delle partite di cui abbiamo la scheda: solo quelle possono essere
   collegate dal calendario completo. */
const schedate = new Set(partite.map((p: any) => p.id));
const idPartita = (casa: string, ospite: string) =>
  `${casa}-${ospite}`.toLowerCase().replace(/[' .]/g, "").replace(/\s+/g, "-");

/* Le squadre che hanno raccolto molto piu' o molto meno del gioco: sono le
   due righe che vale la pena raccontare sopra la tabella. */
const fortunata = classifica.reduce(
  (a: any, r: any) => (!a || r.scarto_punti > a.scarto_punti ? r : a), null
);
const sfortunata = classifica.reduce(
  (a: any, r: any) => (!a || r.scarto_punti < a.scarto_punti ? r : a), null
);

const num = (v: number, d = 2) =>
  v.toLocaleString("it-IT", { minimumFractionDigits: d, maximumFractionDigits: d });
const pct = (v: number, d = 0) => num(v * 100, d) + "%";

const perData = new Map<string, any[]>();
for (const p of partite) {
  if (!perData.has(p.data)) perData.set(p.data, []);
  perData.get(p.data)!.push(p);
}

const dataLunga = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("it-IT", {
    weekday: "long", day: "numeric", month: "long",
  });

const squadreOrdinate = [...team].sort((a, b) => b.gol_fatti - a.gol_fatti);
---

<Base
  titolo={lega.nome}
  descrizione={`Calendario, statistiche e quote di ${lega.nome} (${lega.paese}).`}
>
  <section>
    <p class="occhiello">{lega.bandiera} {lega.paese}</p>
    <div class="hd">
      <h1>{lega.nome}</h1>
      <p>
        {lega.partite_storico.toLocaleString("it-IT")} partite di storico
        {partite.length > 0 && `, ${partite.length} in programma`}.
      </p>
    </div>

    <div class="tessere">
      <div class="tessera">
        <div class="k">Fattore campo</div>
        <div class="v mono">{num(Math.exp(lega.vantaggio_casa))}×</div>
        <div class="n">reti attese in più giocando in casa</div>
      </div>
      <div class="tessera">
        <div class="k">Conversione</div>
        <div class="v mono">{pct(lega.conversione, 1)}</div>
        <div class="n">gol per tiro in porta, media del campionato</div>
      </div>
      <div class="tessera">
        <div class="k">Stagione {lega.stagione}</div>
        <div class="v mono">{lega.giornate_giocate}</div>
        <div class="n">
          {lega.giornate_giocate === 0
            ? "non ancora iniziata"
            : lega.giornate_giocate === 1
              ? "giornata giocata"
              : "giornate giocate"}
        </div>
      </div>
      <div class="tessera">
        <div class="k">In programma</div>
        <div class="v mono">{partite.length}</div>
        <div class="n">nei prossimi giorni</div>
      </div>
    </div>
  </section>

  <section>
    <div class="hd">
      <h2>Calendario</h2>
      <p>La barra è la probabilità del modello. Le quote sono le migliori disponibili.</p>
    </div>
    {
      partite.length === 0 ? (
        <div class="vuoto">
          <b>Nessuna partita in programma</b>
          Il calendario di football-data si aggiorna un paio di volte a
          settimana: se il campionato è fermo o la giornata è appena finita,
          questa sezione resta vuota fino al prossimo aggiornamento.
        </div>
      ) : (
        <div class="slip">
          {[...perData.entries()].map(([giorno, delGiorno]) => (
            <>
              <div class="intestazione-lega">
                <span>{dataLunga(giorno)}</span>
              </div>
              {delGiorno.map((p) => <RigaPartita p={p} slug={lega.slug} />)}
            </>
          ))}
        </div>
      )
    }
  </section>

  {
    completo && (
      <section>
        <div class="hd">
          <h2>Calendario completo</h2>
          <p>
            Tutte le {completo.totale} giornate della stagione, dal calendario
            ufficiale. La giornata in corso è già aperta; le altre si aprono
            con un clic.
          </p>
        </div>
        <div class="calendario-completo">
          {completo.giornate.map((g: any) => {
            const giocate = g.partite.filter((p: any) => p.giocata).length;
            return (
              <details open={g.numero === completo.corrente}>
                <summary>
                  <b>{g.numero}ª giornata</b>
                  <span>
                    {new Date(g.partite[0].data + "T00:00:00").toLocaleDateString(
                      "it-IT", { day: "numeric", month: "short" }
                    )}
                    {giocate === g.partite.length
                      ? " · conclusa"
                      : giocate > 0
                        ? ` · ${giocate} su ${g.partite.length}`
                        : ""}
                  </span>
                </summary>
                <div class="elenco">
                  {g.partite.map((p: any) => {
                    const id = idPartita(p.casa, p.ospite);
                    const collegabile = p.collegabile && schedate.has(id);
                    const Riga = collegabile ? "a" : "div";
                    return (
                      <Riga
                        class="voce"
                        href={collegabile ? `/calcio/${lega.slug}/${id}/` : undefined}
                      >
                        <span class="quando mono">
                          {new Date(p.data + "T00:00:00").toLocaleDateString("it-IT", {
                            day: "2-digit", month: "2-digit",
                          })}
                          {p.ora && <i>{p.ora}</i>}
                        </span>
                        <span class:list={["team", "casa", { spento: p.giocata && p.gol_casa < p.gol_ospite }]}>
                          {p.casa}
                        </span>
                        <b class:list={["esito", "mono", { atteso: !p.giocata }]}>
                          {p.giocata ? `${p.gol_casa}–${p.gol_ospite}` : "–"}
                        </b>
                        <span class:list={["team", { spento: p.giocata && p.gol_ospite < p.gol_casa }]}>
                          {p.ospite}
                        </span>
                        <span class="coda" />
                      </Riga>
                    );
                  })}
                </div>
              </details>
            );
          })}
        </div>
        <p style="font-size:12.5px;color:var(--ink-3);margin-top:12px;line-height:1.55;max-width:78ch">
          <b>I risultati arrivano con uno o due giorni di ritardo.</b> Non siamo
          un sito di risultati in diretta e non possiamo esserlo: le fonti che
          usiamo pubblicano a intervalli — football-data un paio di volte a
          settimana, openfootball quando i suoi volontari aggiornano. Una
          partita giocata ieri sera può quindi comparire ancora senza punteggio.
          Non è un guasto, è il ritardo della fonte.
        </p>
        <p style="font-size:12.5px;color:var(--ink-3);margin-top:8px;line-height:1.55;max-width:78ch">
          Il calendario viene da <b>openfootball</b>, che pubblica quello
          ufficiale con le giornate già numerate. Le quote arrivano invece da
          <b> football-data</b>, che ne espone una settimana per volta: per
          questo le partite lontane compaiono qui ma non hanno ancora una scheda.
        </p>
      </section>
    )
  }

  {
    classifica.length > 0 && (
      <section>
        <div class="hd">
          <h2>Classifica {lega.stagione}</h2>
          <p>
            Dopo {lega.giornate_giocate}
            {lega.giornate_giocate === 1 ? " giornata" : " giornate"}. Accanto ai
            punti veri, quelli che il gioco avrebbe prodotto.
          </p>
        </div>

        {
          lega.giornate_giocate < 5 ? (
            <div class="prosa" style="margin-bottom:20px">
              <p>
                La stagione è appena cominciata: <strong>con
                {" "}{lega.giornate_giocate === 1 ? "una giornata" : `${lega.giornate_giocate} giornate`}
                {" "}questa tabella non dice ancora niente</strong> su chi è forte
                e chi no. La lasciamo perché è la classifica, ma per farsi un'idea
                delle squadre servono i numeri più sotto, che guardano indietro
                oltre la sosta estiva.
              </p>
            </div>
          ) : (
            fortunata && sfortunata && fortunata.squadra !== sfortunata.squadra && (
              <div class="prosa" style="margin-bottom:20px">
                <p>
                  <strong>{fortunata.squadra}</strong> ha raccolto
                  {" "}{num(Math.abs(fortunata.scarto_punti), 1)} punti più di quanti
                  ne dicano i tiri, <strong>{sfortunata.squadra}</strong>
                  {" "}{num(Math.abs(sfortunata.scarto_punti), 1)} in meno. Sulla
                  distanza questi scarti tendono a chiudersi.
                </p>
              </div>
            )
          )
        }

        <div class="scorri">
          <table class="dati classifica">
            <thead>
              <tr>
                <th class="pos">#</th>
                <th>Squadra</th>
                <th class="num">G</th>
                <th class="num">V</th>
                <th class="num">N</th>
                <th class="num">P</th>
                <th class="num">GF</th>
                <th class="num">GS</th>
                <th class="num">DR</th>
                <th class="num">Punti</th>
                <th class="num evidenza">Attesi</th>
                <th class="num evidenza">Scarto</th>
              </tr>
            </thead>
            <tbody>
              {classifica.map((r: any) => (
                <tr>
                  <td class="pos">
                    {r.posizione}
                    {r.salto !== 0 && (
                      <i class:list={["salto", { su: r.salto < 0 }]}>
                        {r.salto < 0 ? "▲" : "▼"}{Math.abs(r.salto)}
                      </i>
                    )}
                  </td>
                  <td><b>{r.squadra}</b></td>
                  <td class="num">{r.giocate}</td>
                  <td class="num">{r.vinte}</td>
                  <td class="num">{r.pareggiate}</td>
                  <td class="num">{r.perse}</td>
                  <td class="num">{r.fatti}</td>
                  <td class="num">{r.subiti}</td>
                  <td class="num">{r.differenza > 0 ? "+" : ""}{r.differenza}</td>
                  <td class="num"><b>{r.punti}</b></td>
                  <td class="num evidenza">{num(r.punti_attesi, 1)}</td>
                  <td
                    class="num evidenza"
                    style={`font-weight:600;color:${
                      r.scarto_punti > 0 ? "var(--s2)" : "var(--s1)"
                    }`}
                  >
                    {r.scarto_punti > 0 ? "+" : ""}{num(r.scarto_punti, 1)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:12.5px;color:var(--ink-3);margin-top:12px;line-height:1.55;max-width:80ch">
          <b>Attesi</b> sono i punti che ogni squadra avrebbe raccolto se i gol
          fossero caduti secondo i tiri in porta prodotti: per ogni partita si
          pesa ogni esito per la sua probabilità, invece di assegnare la vittoria
          a chi ha creato di più. La freccia accanto alla posizione dice dove
          starebbe la squadra in quella classifica.
        </p>
      </section>
    )
  }

  {
    ultimi.length > 0 && (
      <section>
        <div class="hd">
          <h2>Risultati</h2>
          <p>
            Per giornata, dalla più recente. Con i tiri in porta accanto al
            punteggio: spesso raccontano un'altra partita.
          </p>
        </div>
        {ultimi.map((g: any) => (
        <div class="giornata">
          <div class="titolo-giornata">
            <b>{g.giornata}ª giornata</b>
            {g.stagione_scorsa && <span>stagione {lega.stagione_precedente}</span>}
          </div>
        <div class="slip">
          {g.partite.map((r: any) => {
            const scarto =
              r.in_porta_casa !== null
                ? r.in_porta_casa - r.in_porta_ospite
                : null;
            const vinceCasa = r.gol_casa > r.gol_ospite;
            const vinceOspite = r.gol_ospite > r.gol_casa;
            /* Il gioco dice l'opposto del punteggio: e' la riga da notare. */
            const controcorrente =
              scarto !== null &&
              ((vinceCasa && scarto <= -3) || (vinceOspite && scarto >= 3));
            return (
              <div class:list={["risultato", { controcorrente }]}>
                <span class="quando mono">
                  {new Date(r.data + "T00:00:00").toLocaleDateString("it-IT", {
                    day: "2-digit", month: "2-digit",
                  })}
                </span>
                <span class:list={["team", { spento: vinceOspite }]}>{r.casa}</span>
                <b class="punteggio mono">{r.gol_casa}–{r.gol_ospite}</b>
                <span class:list={["team", { spento: vinceCasa }]}>{r.ospite}</span>
                <span class="tiri mono">
                  {r.in_porta_casa !== null
                    ? `${r.in_porta_casa}–${r.in_porta_ospite}`
                    : "—"}
                </span>
              </div>
            );
          })}
        </div>
        </div>
        ))}
        <p style="font-size:12.5px;color:var(--ink-3);margin-top:12px;line-height:1.5">
          L'ultima colonna sono i tiri in porta. Le righe evidenziate sono quelle
          in cui ha vinto chi ne ha fatti almeno tre in meno. La giornata non è
          pubblicata dalla fonte: si deduce contando le partite già giocate da
          ogni squadra, così i recuperi restano al turno a cui appartengono.
        </p>
      </section>
    )
  }

  <section>
    <div class="hd">
      <h2>Le squadre, ultime {lega.finestra_statistiche} partite</h2>
      <p>
        Non la stagione in corso — sarebbe un campione troppo piccolo ad agosto.
        Una finestra mobile che scavalca la sosta: una squadra non cambia da
        maggio a settembre quanto la classifica lascerebbe credere.
      </p>
    </div>
    <div class="scorri">
      <table class="dati">
        <thead>
          <tr>
            <th>Squadra</th>
            <th class="num">Partite</th>
            <th class="num">Gol fatti</th>
            <th class="num">Gol subiti</th>
            <th class="num">Tiri in porta</th>
            <th class="num">Over 2,5</th>
            <th class="num">Gol/Gol</th>
            <th class="num">Segna vs crea</th>
          </tr>
        </thead>
        <tbody>
          {
            squadreOrdinate.map((s) => (
              <tr>
                <td><b>{s.squadra}</b></td>
                <td class="num">{s.partite}</td>
                <td class="num">{num(s.gol_fatti)}</td>
                <td class="num">{num(s.gol_subiti)}</td>
                <td class="num">
                  {num((s.casa.in_porta + s.trasferta.in_porta) / 2, 1)}
                </td>
                <td class="num">
                  {pct((s.casa.over_25 * s.casa.partite + s.trasferta.over_25 * s.trasferta.partite) /
                    Math.max(s.partite, 1))}
                </td>
                <td class="num">
                  {pct((s.casa.gol_gol * s.casa.partite + s.trasferta.gol_gol * s.trasferta.partite) /
                    Math.max(s.partite, 1))}
                </td>
                <td
                  class="num"
                  style={`font-weight:600;color:${
                    s.scarto_conversione > 0 ? "var(--s2)" : "var(--s1)"
                  }`}
                >
                  {s.scarto_conversione >= 0 ? "+" : ""}{num(s.scarto_conversione, 1)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p style="font-size:12.5px;color:var(--ink-3);margin-top:12px;line-height:1.55;max-width:76ch">
      «Segna vs crea» è la differenza fra i gol segnati e quelli che i tiri in
      porta avrebbero fatto prevedere, alla conversione media del campionato
      ({pct(lega.conversione, 1)}). Positivo vuol dire che sta segnando più di
      quanto crea: può essere un attaccante in stato di grazia quanto fortuna, e
      le due si distinguono solo col tempo — ma sulla stagione la fortuna
      rientra e la bravura no.
    </p>
  </section>
</Base>

<style>
  table.classifica td.pos,
  table.classifica th.pos {
    width: 62px;
    color: var(--ink-3);
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* I colori devono dire la stessa cosa della colonna "Scarto", altrimenti la
     stessa riga si contraddice da sola.
     Ocra = ha raccolto piu' di quanto ha creato (scende nella classifica del
     gioco). Blu = ha creato piu' di quanto ha raccolto, ed e' quella
     sottovalutata. */
  .salto {
    font-style: normal;
    font-size: 9.5px;
    margin-left: 4px;
    color: var(--s2);
  }
  .salto.su {
    color: var(--s1);
  }
  table.classifica .evidenza {
    background: var(--sunk);
  }
  table.classifica th.evidenza {
    color: var(--ink-2);
  }

  .calendario-completo {
    border: 1px solid var(--rule);
    background: var(--card);
  }
  .calendario-completo details {
    border-bottom: 1px solid var(--rule);
  }
  .calendario-completo details:last-child {
    border-bottom: 0;
  }
  .calendario-completo summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 18px;
    cursor: pointer;
    list-style: none;
  }
  .calendario-completo summary::-webkit-details-marker {
    display: none;
  }
  .calendario-completo summary::before {
    content: "▸";
    color: var(--ink-3);
    margin-right: 8px;
    font-size: 10px;
  }
  .calendario-completo details[open] > summary::before {
    content: "▾";
  }
  .calendario-completo details[open] > summary {
    background: var(--sunk);
    border-bottom: 1px solid var(--rule);
  }
  .calendario-completo summary b {
    font-size: 13.5px;
    font-weight: 600;
    flex: 1;
  }
  .calendario-completo summary span {
    font-size: 11.5px;
    color: var(--ink-3);
  }

  /* La colonna di coda in fondo pareggia quella della data: senza, il
     punteggio finisce a destra del centro della riga invece che al centro. */
  .elenco .voce {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 72px minmax(0, 1fr) 96px;
    gap: 12px;
    align-items: baseline;
    padding: 7px 18px;
    font-size: 13.5px;
    text-decoration: none;
    color: inherit;
  }
  .elenco a.voce:hover {
    background: var(--sunk);
  }
  .elenco .quando {
    font-size: 11.5px;
    color: var(--ink-3);
  }
  .elenco .quando i {
    font-style: normal;
    margin-left: 6px;
  }
  .elenco .team {
    font-weight: 500;
    min-width: 0;
  }
  /* Con una classe esplicita e non con nth-of-type: il primo <span> della riga
     e' la data, quindi `.team:nth-of-type(1)` non corrispondeva a niente e la
     squadra di casa restava allineata a sinistra. */
  .elenco .team.casa {
    text-align: right;
  }
  .elenco .team.spento {
    color: var(--ink-3);
  }
  .elenco .esito {
    text-align: center;
    font-weight: 600;
    color: var(--ink);
    font-size: 14px;
  }
  .elenco .esito.atteso {
    color: var(--ink-3);
    font-weight: 400;
  }
  @media (max-width: 640px) {
    .elenco .voce {
      grid-template-columns: 1fr 56px 1fr;
    }
    .elenco .quando {
      grid-column: 1 / -1;
    }
    .elenco .coda {
      display: none;
    }
  }

  .giornata {
    margin-bottom: 18px;
  }
  .titolo-giornata {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 18px;
    background: var(--board);
    color: var(--board-ink);
  }
  .titolo-giornata b {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .titolo-giornata span {
    font-size: 11px;
    color: var(--board-ink-2);
  }

  .risultato {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 62px minmax(0, 1fr) 62px;
    gap: 12px;
    align-items: baseline;
    padding: 9px 18px;
    border-bottom: 1px solid var(--rule);
    font-size: 13.5px;
  }
  .risultato:last-child {
    border-bottom: 0;
  }
  .risultato.controcorrente {
    background: var(--sunk);
    box-shadow: inset 3px 0 0 var(--s2);
  }
  .risultato .quando {
    font-size: 11.5px;
    color: var(--ink-3);
  }
  .risultato .team {
    font-weight: 600;
    min-width: 0;
  }
  .risultato .team:nth-of-type(2) {
    text-align: right;
  }
  /* Chi ha perso resta leggibile ma spento: il vincitore si vede al volo. */
  .risultato .team.spento {
