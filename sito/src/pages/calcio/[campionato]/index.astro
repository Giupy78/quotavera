---
import Base from "../../../layouts/Base.astro";
import RigaPartita from "../../../components/RigaPartita.astro";
import campionati from "../../../dati/campionati.json";
import calendario from "../../../dati/calendario.json";
import squadre from "../../../dati/squadre.json";

export function getStaticPaths() {
  const cal = calendario.campionati as Record<string, any[]>;
  const sq = squadre.campionati as Record<string, any[]>;
  return campionati.campionati.map((c) => ({
    params: { campionato: c.slug },
    props: { lega: c, partite: cal[c.slug] ?? [], team: sq[c.slug] ?? [] },
  }));
}

const { lega, partite, team } = Astro.props;

const num = (v: number, d = 2) =>
  v.toLocaleString("it-IT", { minimumFractionDigits: d, maximumFractionDigits: d });
const pct = (v: number, d = 0) => num(v * 100, d) + "%";

const perData = new Map<string, any[]>();
for (const p of partite) {
  if (!perData.has(p.data)) perData.set(p.data, []);
  perData.get(p.data)!.push(p);
}

const dataLunga = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("it-IT", {
    weekday: "long", day: "numeric", month: "long",
  });

const classifica = [...team].sort((a, b) => b.gol_fatti - a.gol_fatti);
---

<Base
  titolo={lega.nome}
  descrizione={`Calendario, statistiche e quote di ${lega.nome} (${lega.paese}).`}
>
  <section>
    <p class="occhiello">{lega.bandiera} {lega.paese}</p>
    <div class="hd">
      <h1>{lega.nome}</h1>
      <p>
        {lega.partite_storico.toLocaleString("it-IT")} partite di storico,
        {" "}{team.length} squadre, {partite.length} in programma.
      </p>
    </div>

    <div class="tessere">
      <div class="tessera">
        <div class="k">Fattore campo</div>
        <div class="v mono">{num(Math.exp(lega.vantaggio_casa))}×</div>
        <div class="n">reti attese in più giocando in casa</div>
      </div>
      <div class="tessera">
        <div class="k">Conversione</div>
        <div class="v mono">{pct(lega.conversione, 1)}</div>
        <div class="n">gol per tiro in porta, media del campionato</div>
      </div>
      <div class="tessera">
        <div class="k">Partite in stagione</div>
        <div class="v mono">{lega.partite_stagione}</div>
        <div class="n">già giocate, su cui si basano le statistiche</div>
      </div>
      <div class="tessera">
        <div class="k">In programma</div>
        <div class="v mono">{partite.length}</div>
        <div class="n">nei prossimi giorni</div>
      </div>
    </div>
  </section>

  <section>
    <div class="hd">
      <h2>Calendario</h2>
      <p>La barra è la probabilità del modello. Le quote sono le migliori disponibili.</p>
    </div>
    {
      partite.length === 0 ? (
        <div class="vuoto">
          <b>Nessuna partita in programma</b>
          Il calendario di football-data si aggiorna un paio di volte a
          settimana: se il campionato è fermo o la giornata è appena finita,
          questa sezione resta vuota fino al prossimo aggiornamento.
        </div>
      ) : (
        <div class="slip">
          {[...perData.entries()].map(([giorno, delGiorno]) => (
            <>
              <div class="intestazione-lega">
                <span>{dataLunga(giorno)}</span>
              </div>
              {delGiorno.map((p) => <RigaPartita p={p} slug={lega.slug} />)}
            </>
          ))}
        </div>
      )
    }
  </section>

  <section>
    <div class="hd">
      <h2>Le squadre, in stagione</h2>
      <p>
        Ordinate per gol fatti a partita. La colonna che conta è l'ultima: gol
        veri contro gol attesi dai tiri in porta.
      </p>
    </div>
    <div class="scorri">
      <table class="dati">
        <thead>
          <tr>
            <th>Squadra</th>
            <th class="num">Partite</th>
            <th class="num">Gol fatti</th>
            <th class="num">Gol subiti</th>
            <th class="num">Tiri in porta</th>
            <th class="num">Over 2,5</th>
            <th class="num">Gol/Gol</th>
            <th class="num">Segna vs crea</th>
          </tr>
        </thead>
        <tbody>
          {
            classifica.map((s) => (
              <tr>
                <td><b>{s.squadra}</b></td>
                <td class="num">{s.partite}</td>
                <td class="num">{num(s.gol_fatti)}</td>
                <td class="num">{num(s.gol_subiti)}</td>
                <td class="num">
                  {num((s.casa.in_porta + s.trasferta.in_porta) / 2, 1)}
                </td>
                <td class="num">
                  {pct((s.casa.over_25 * s.casa.partite + s.trasferta.over_25 * s.trasferta.partite) /
                    Math.max(s.partite, 1))}
                </td>
                <td class="num">
                  {pct((s.casa.gol_gol * s.casa.partite + s.trasferta.gol_gol * s.trasferta.partite) /
                    Math.max(s.partite, 1))}
                </td>
                <td
                  class="num"
                  style={`font-weight:600;color:${
                    s.scarto_conversione > 0 ? "var(--s2)" : "var(--s1)"
                  }`}
                >
                  {s.scarto_conversione >= 0 ? "+" : ""}{num(s.scarto_conversione, 1)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p style="font-size:12.5px;color:var(--ink-3);margin-top:12px;line-height:1.55;max-width:76ch">
      «Segna vs crea» è la differenza fra i gol segnati e quelli che i tiri in
      porta avrebbero fatto prevedere, alla conversione media del campionato
      ({pct(lega.conversione, 1)}). Positivo vuol dire che sta segnando più di
      quanto crea: può essere un attaccante in stato di grazia quanto fortuna, e
      le due si distinguono solo col tempo — ma sulla stagione la fortuna
      rientra e la bravura no.
    </p>
  </section>
</Base>

<style>
  .intestazione-lega span {
    display: block;
    padding: 9px 18px 5px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    background: var(--sunk);
    border-bottom: 1px solid var(--rule);
  }
</style>
