---
import Base from "../../../layouts/Base.astro";
import Bandiera from "../../../components/Bandiera.astro";
import MatriceRisultati from "../../../components/MatriceRisultati.astro";
import SchedaGiocata from "../../../components/SchedaGiocata.astro";
import campionati from "../../../dati/campionati.json";
import schede from "../../../dati/schede.json";
import { lumacaSquadra } from "../../../lib/indirizzi";
import { indirizzo } from "../../../lib/paesi";

export function getStaticPaths() {
  const leghe = Object.fromEntries(campionati.campionati.map((c) => [c.slug, c]));
  return schede.partite.map((p: any) => ({
    params: { campionato: p.campionato, partita: p.id },
    props: { p, lega: leghe[p.campionato] },
  }));
}

const { p, lega } = Astro.props;

const num = (v: number, d = 2) =>
  v.toLocaleString("it-IT", { minimumFractionDigits: d, maximumFractionDigits: d });
const pct = (v: number, d = 0) => num(v * 100, d) + "%";

const giorno = new Date(p.data + "T00:00:00");
/* Titolo e descrizione cambiano a partita giocata: chi cerca "Inter Monza" il
   giorno dopo vuole il risultato, e il risultato nel titolo e' anche l'unica
   cosa che distingue questa pagina dalle altre mille agli occhi di un motore
   di ricerca. */
/* "statistiche" nel titolo non e' riempitivo: delle 59 ricerche che in tre
   mesi hanno mostrato il sito, la forma piu' frequente e' esattamente
   "statistiche squadra A - squadra B", seguita da "quote squadra A squadra B".
   Il titolo deve contenere le parole con cui la gente cerca, altrimenti
   Google ci accosta alla ricerca ma con poca convinzione — ed e' il motivo
   per cui la posizione media e' 41. */
const titolo = p.giocata
  ? `${p.casa} ${p.gol_casa}-${p.gol_ospite} ${p.ospite}: statistiche`
  : `${p.casa} — ${p.ospite}: statistiche, probabilità e quote`;
const descrizione = p.giocata
  ? `${p.casa} ${p.gol_casa}-${p.gol_ospite} ${p.ospite}: risultato, statistiche `
    + `della partita e cosa diceva il nostro modello prima che si giocasse.`
  : `${p.casa} — ${p.ospite}: statistiche delle due squadre, probabilità del `
    + `modello e quote del mercato a confronto.`;

/* Una partita dura un'ora e tre quarti scarsa più l'intervallo: due ore è una
   stima onesta, e `endDate` Google la vuole. Non fingiamo di conoscere il
   minuto esatto del fischio finale — non ce l'abbiamo — ma un evento senza
   fine dichiarata vale meno di uno con una fine ragionevole. */
const inizio = p.ora ? `${p.data}T${p.ora}:00` : `${p.data}T15:00:00`;
/* Due ore avanti restando nel fuso della partita: si tratta la stringa come
   se fosse UTC e si riformatta in UTC, cosi' l'andata e il ritorno si
   annullano. Passare per il fuso locale era l'errore di prima — `toISOString`
   riportava indietro le stesse due ore appena aggiunte e la fine tornava
   uguale all'inizio. */
const fine = new Date(new Date(`${inizio}Z`).getTime() + 2 * 3600 * 1000)
  .toISOString()
  .slice(0, 19);

/* Da ieri ogni squadra ha la sua pagina: dirlo qui lega le duemila schede
   partita alle quattrocento pagine squadra anche per chi legge il markup e non
   i collegamenti. */
const viaSquadra = (nome: string) =>
  lega?.slug && Astro.site
    ? { url: new URL(`/calcio/${lega.slug}/squadra/${lumacaSquadra(nome)}/`, Astro.site).href }
    : {};

const datiStrutturati = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  name: p.giocata
    ? `${p.casa} ${p.gol_casa}-${p.gol_ospite} ${p.ospite}`
    : `${p.casa} — ${p.ospite}`,
  startDate: inizio,
  endDate: fine,
  /* `EventStatusType` non ha un valore "conclusa": i soli ammessi sono
     Scheduled, Cancelled, Postponed, Rescheduled, MovedOnline. Una partita
     giocata come da calendario resta EventScheduled; inventare un
     EventCompleted darebbe un errore nuovo al posto di quello appena
     chiuso. */
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  sport: "Soccer",
  /* `location` e' obbligatorio: senza, Search Console segnala un errore
     critico e la pagina non puo' comparire con le sue informazioni. Lo stadio
     ce lo da' ESPN nella stessa risposta del resto. Dove manca si mette il
     campo di casa della squadra ospitante: e' impreciso, ma un campo assente
     e' peggio di uno approssimato, e non stiamo inventando un indirizzo.
     L'indirizzo c'e' in tutt'e due i casi. Il paese lo sappiamo sempre — e'
     quello del campionato, e una partita casalinga si gioca li' — e la citta'
     solo quando lo stadio ce l'ha dato ESPN. Un `location` senza `address` e'
     il secondo dei due avvisi arrivati da Search Console il 26 ottobre, ed e'
     comparso solo perche' il primo, `location` del tutto assente, era stato
     chiuso: Google non puo' lamentarsi di un campo dentro un oggetto che non
     esiste. */
  location: {
    "@type": "Place",
    name: p.stadio ? p.stadio.nome : `Campo di casa di ${p.casa}`,
    address: indirizzo(lega?.paese, p.stadio?.citta),
  },
  /* `url` sull'organizzatore: la pagina del campionato. E' l'altro avviso
     dello stesso messaggio, e la pagina esiste gia'. */
  organizer: {
    "@type": "SportsOrganization",
    name: lega?.nome,
    ...(lega?.slug && Astro.site
      ? { url: new URL(`/calcio/${lega.slug}/`, Astro.site).href }
      : {}),
  },
  /* `performer` duplica `competitor` ed e' voluto: `competitor` e' la forma
     giusta per una partita, `performer` e' quella che il controllo generico
     sugli eventi si aspetta. Dirla in tutt'e due i modi costa due righe. */
  performer: [
    { "@type": "SportsTeam", name: p.casa, ...viaSquadra(p.casa) },
    { "@type": "SportsTeam", name: p.ospite, ...viaSquadra(p.ospite) },
  ],
  competitor: [
    {
      "@type": "SportsTeam",
      name: p.casa,
      /* Il nome esteso — "AFC Bournemouth" dove noi scriviamo "Bournemouth" —
         e' quello con cui si cerca su Google. Sta qui e non in pagina: ai
         lettori la forma corta basta, al motore di ricerca serve sapere che
         sono la stessa squadra. */
      ...(p.casa_esteso ? { alternateName: p.casa_esteso } : {}),
      ...viaSquadra(p.casa),
    },
    {
      "@type": "SportsTeam",
      name: p.ospite,
      ...(p.ospite_esteso ? { alternateName: p.ospite_esteso } : {}),
      ...viaSquadra(p.ospite),
    },
  ],
  superEvent: { "@type": "SportsOrganization", name: lega?.nome },
  ...(p.giocata
    ? {
        description: `${p.casa} ${p.gol_casa}-${p.gol_ospite} ${p.ospite}, `
          + `${lega?.nome}: risultato e statistiche della partita.`,
      }
    : {}),
};

const c = p.stat_casa, o = p.stat_ospite;
const fc = p.forma_casa, fo = p.forma_ospite;

/* Il confronto è casa-contro-trasferta e non totale-contro-totale: una squadra
   che in casa segna il doppio che fuori è un'informazione che la media
   complessiva cancella del tutto. */
const confronto = c && o ? [
  ["Gol fatti a partita", c.casa.gol_fatti, o.trasferta.gol_fatti, 2],
  ["Gol subiti a partita", c.casa.gol_subiti, o.trasferta.gol_subiti, 2],
  ["Tiri a partita", c.casa.tiri, o.trasferta.tiri, 1],
  ["Tiri in porta", c.casa.in_porta, o.trasferta.in_porta, 1],
  ["Tiri in porta concessi", c.casa.in_porta_subiti, o.trasferta.in_porta_subiti, 1],
  ["Corner a partita", c.casa.corner, o.trasferta.corner, 1],
  ["Cartellini a partita", c.casa.cartellini, o.trasferta.cartellini, 1],
] : [];

const percentuali = c && o ? [
  ["Over 2,5", c.casa.over_25, o.trasferta.over_25],
  ["Gol / Gol", c.casa.gol_gol, o.trasferta.gol_gol],
  ["Porta inviolata", c.casa.clean_sheet, o.trasferta.clean_sheet],
  ["Rimasta a secco", c.casa.a_secco, o.trasferta.a_secco],
] : [];

const etichette = ["1", "X", "2"];
const nomiEsito = [p.casa, "pareggio", p.ospite];
const derivati: { nome: string; p: number }[] = [];
if (p.dettaglio) {
  const mercati = p.dettaglio.mercati as Record<string, Record<string, number>>;
  for (const [nome, esiti] of Object.entries(mercati)) {
    if (nome === "1x2") continue;
    for (const [esito, prob] of Object.entries(esiti)) {
      const soglia = nome.startsWith("ou_") ? nome.slice(3).replace(".", ",") : "";
      const label =
        nome === "btts"
          ? `Gol / Gol: ${esito === "si" ? "sì" : "no"}`
          : `${esito === "over" ? "Over" : "Under"} ${soglia}`;
      derivati.push({ nome: label, p: prob });
    }
  }
}
---

<Base titolo={titolo} descrizione={descrizione}>
  {/* Dati strutturati: dicono a Google *cosa* e' questa pagina, non solo cosa
      c'e' scritto sopra. Una partita fra due squadre, in una data, in un
      campionato — e, quando e' finita, com'e' andata. Senza, una scheda
      partita e' indistinguibile da una pagina qualsiasi che nomina due
      squadre, ed e' una delle ragioni per cui finiamo in quarta pagina.

      Sta nel corpo e non nella testa perche' il layout e' condiviso: a Google
      va bene lo stesso, JSON-LD si legge ovunque nel documento. */}
  <script type="application/ld+json" set:html={JSON.stringify(datiStrutturati)} />

  {/* Due pagine allo stesso indirizzo: prima del fischio l'anteprima,
      dopo il risultato con quello che dicevamo prima. Lo stesso indirizzo
      di proposito — e' quello che Google ha gia' indicizzato, e prima
      spariva appena la partita si giocava. */}
  {p.giocata ? (
    <SchedaGiocata p={p} lega={lega} />
  ) : (
    <>
  <section>
    <p class="occhiello">
      <a href={`/calcio/${lega.slug}/`} style="color:inherit"><Bandiera e={lega.bandiera} /> {lega.nome}</a>
      {" · "}
      {giorno.toLocaleDateString("it-IT", { weekday: "long", day: "numeric", month: "long" })}
      {p.ora && ` · ${p.ora}`}
    </p>
    <div class="hd">
      <h1>{p.casa} — {p.ospite}</h1>
      {
        p.dettaglio && (
          <p>
            Reti attese <span class="mono">{num(p.dettaglio.gol_attesi_casa)}</span> —
            <span class="mono">{num(p.dettaglio.gol_attesi_ospite)}</span>
          </p>
        )
      }
    </div>

    {/* La data e' passata ma il risultato non ci e' arrivato. Le cause
        possibili sono due e da qui non si distinguono: la partita e' stata
        rinviata, oppure si e' giocata in un campionato che una sola delle
        nostre fonti copre e quella fonte e' indietro. L'avviso dice le due
        cose invece di sceglierne una: la prima versione scriveva "la partita
        risulta giocata", che per una partita rinviata e' falso. */}
    {
      p.senza_risultato && (
        <div class="vuoto" style="margin:18px 0">
          <b>Il risultato non ci è arrivato</b>
          La data della partita è passata, ma nessuna delle nostre fonti ha
          pubblicato il punteggio: può essere stata rinviata, oppure il dato
          deve ancora arrivare. Qui sotto resta quello che sapevamo prima. Se
          la partita viene giocata o rimessa in calendario, questa pagina si
          aggiorna da sé.
        </div>
      )
    }

    {
      p.p_modello && (
        <div class="sintesi">
          {p.p_modello.map((x: number, i: number) => (
            <div class="voce">
              <div class="et">{etichette[i]} — {nomiEsito[i]}</div>
              <div class="valore mono">{pct(x)}</div>
              <div class="sotto">
                quota equa <b class="mono">{num(1 / x)}</b>
                {p.p_mercato && (
                  <span> · mercato <b class="mono">{pct(p.p_mercato[i])}</b></span>
                )}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </section>

  {
    c && o && (
      <section>
        <div class="hd">
          <h2>I numeri delle due squadre</h2>
          <p>
            {p.casa} in casa contro {p.ospite} in trasferta — non le medie
            complessive, che nascondono proprio la differenza che conta.
          </p>
        </div>

        <div class="scorri">
          <table class="dati confronto">
            <thead>
              <tr>
                <th>{p.casa} <small>(in casa)</small></th>
                <th class="mezzo" />
                <th class="destra">{p.ospite} <small>(in trasferta)</small></th>
              </tr>
            </thead>
            <tbody>
              {confronto.map(([nome, a, b, d]: any) => (
                <tr>
                  <td class="num forte">{num(a, d)}</td>
                  <td class="mezzo">{nome}</td>
                  <td class="destra forte">{num(b, d)}</td>
                </tr>
              ))}
              {percentuali.map(([nome, a, b]: any) => (
                <tr>
                  <td class="num">{pct(a)}</td>
                  <td class="mezzo">{nome}</td>
                  <td class="destra">{pct(b)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    p.incrocio && (
      <section>
        <div class="hd">
          <h2>L'incrocio: attacco contro difesa</h2>
          <p>
            La tabella sopra mette i due attacchi uno accanto all'altro, ma le
            due squadre hanno giocato contro avversari diversi: confrontarle
            direttamente dice poco. Qui invece si incrocia — quanto
            {" "}<b>{p.casa}</b> produce in casa contro quanto
            {" "}<b>{p.ospite}</b> concede in trasferta. È la domanda a cui
            serve rispondere per capire che partita sarà.
          </p>
        </div>

        <div class="scorri">
          <table class="dati confronto">
            <thead>
              <tr>
                <th>{p.casa} <small>(produce in casa)</small></th>
                <th class="mezzo" />
                <th class="destra">{p.ospite} <small>(concede fuori)</small></th>
                <th class="num media">Attesa</th>
              </tr>
            </thead>
            <tbody>
              {p.incrocio.map((r: any) => (
                <tr>
                  <td class="num forte">{r.attacco}</td>
                  <td class="mezzo">{r.voce}</td>
                  <td class="destra forte">{r.difesa}</td>
                  <td class="num media">{r.media === null ? "—" : r.media}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="nota-incrocio">
          La colonna <b>Attesa</b> è la media fra i due numeri, e va letta per
          quello che è: una stima grezza, non una previsione del modello. Quando
          i due valori sono lontani — un attacco prolifico contro una difesa
          solida — la media sta nel mezzo e nasconde proprio l'incertezza che
          rende la partita interessante. Le probabilità vere sono più sotto.
        </p>
      </section>
    )
  }

  {
    c && o && (
      <section>
        <div class="hd">
          <h2>Segnano più o meno di quanto creano?</h2>
          <p>
            Gol veri contro gol attesi dai tiri in porta, alla conversione media
            del campionato ({pct(lega.conversione, 1)}).
          </p>
        </div>
        <div class="duo">
          {[c, o].map((s) => (
            <div class="pannello">
              <h3>{s.squadra}</h3>
              <p class="sub">
                {s.gol_totali} gol da {s.in_porta_totali} tiri in porta
              </p>
              <div
                class="scarto mono"
                style={`color:${s.scarto_conversione > 0 ? "var(--s2)" : "var(--s1)"}`}
              >
                {s.scarto_conversione >= 0 ? "+" : ""}{num(s.scarto_conversione, 1)}
              </div>
              <p class="sub" style="margin:0">
                {s.scarto_conversione >= 0 ? "sopra" : "sotto"} i
                {" "}{num(s.attesi_dai_tiri, 1)} attesi
              </p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    fc && fo && (
      <section>
        <div class="hd">
          <h2>La forma, misurata sui tiri</h2>
          <p>
            Ultime sei partite. Sui tiri in porta e non sui risultati: i gol
            sono troppo pochi perché cinque partite dicano qualcosa.
          </p>
        </div>
        <div class="scorri">
          <table class="dati">
            <thead>
              <tr>
                <th>Squadra</th>
                <th class="num">Partite</th>
                <th class="num">Tiri in porta</th>
                <th class="num">Concessi</th>
                <th class="num">Gol fatti</th>
                <th class="num">Gol subiti</th>
              </tr>
            </thead>
            <tbody>
              {[fc, fo].map((s) => (
                <tr>
                  <td><b>{s.squadra}</b></td>
                  <td class="num">{s.partite}</td>
                  <td class="num">
                    {num((s.casa.in_porta * s.casa.partite + s.trasferta.in_porta * s.trasferta.partite) /
                      Math.max(s.partite, 1), 1)}
                  </td>
                  <td class="num">
                    {num((s.casa.in_porta_subiti * s.casa.partite +
                      s.trasferta.in_porta_subiti * s.trasferta.partite) /
                      Math.max(s.partite, 1), 1)}
                  </td>
                  <td class="num">{num(s.gol_fatti)}</td>
                  <td class="num">{num(s.gol_subiti)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    p.dettaglio && (
      <section>
        <div class="hd">
          <h2>Dentro il modello</h2>
          <p>
            Tutti i mercati escono da una tabella sola: sono somme di celle, non
            stime separate.
          </p>
        </div>
        <div class="feature">
          <div class="pannello">
            <h3>Probabilità di ogni risultato esatto</h3>
            <p class="sub">Valori in percentuale.</p>
            <MatriceRisultati matrice={p.dettaglio.matrice} casa={p.casa} ospite={p.ospite} />
          </div>
          <div>
            <div class="pannello">
              <h3>Mercati derivati</h3>
              <p class="sub">A destra la quota equa corrispondente.</p>
              <div class="mkt">
                {derivati.map((d) => (
                  <div>
                    <span>{d.nome}</span>
                    <b class="mono">{pct(d.p, 1)}</b>
                    <span class="q mono">{num(1 / d.p)}</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="pannello" style="margin-top:26px">
              <h3>Risultati più probabili</h3>
              <p class="sub">Le cinque celle più alte della tabella accanto.</p>
              <div class="mkt">
                {p.dettaglio.risultati_probabili.map((r: any) => (
                  <div>
                    <span class="mono">{r.risultato}</span>
                    <b class="mono">{pct(r.p, 1)}</b>
                    <span class="q mono">{num(1 / r.p)}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    p.precedenti.length > 0 && (
      <section>
        <div class="hd"><h2>Precedenti</h2></div>
        <div class="scorri">
          <table class="dati">
            <tbody>
              {p.precedenti.map((x: any) => (
                <tr>
                  <td class="mono" style="color:var(--ink-3);white-space:nowrap">
                    {new Date(x.data + "T00:00:00").toLocaleDateString("it-IT")}
                  </td>
                  <td style="text-align:right"><b>{x.casa}</b></td>
                  <td class="mono" style="text-align:center;width:70px">
                    {x.gol_casa}–{x.gol_ospite}
                  </td>
                  <td><b>{x.ospite}</b></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <section>
    <div class="hd">
      <h2>Le quote, e quanto si tiene il banco</h2>
      <p>
        <a href="/quote/">Come si leggono questi numeri →</a>
      </p>
    </div>
    <div class="scorri">
      <table class="dati">
        <thead>
          <tr>
            <th>Fonte</th>
            <th class="num">1</th>
            <th class="num">X</th>
            <th class="num">2</th>
            <th class="num">Margine</th>
          </tr>
        </thead>
        <tbody>
          {
            Object.entries(p.quote).map(([libro, q]: any) => {
              const m = q.reduce((s: number, x: number) => s + 1 / x, 0) - 1;
              return (
                <tr>
                  <td>
                    <b>{libro === "massimo" ? "Miglior prezzo" : libro === "media" ? "Media dei libri" : libro}</b>
                  </td>
                  {q.map((x: number) => <td class="num">{num(x)}</td>)}
                  <td class="num" style={`color:${m < 0.02 ? "var(--good)" : "var(--ink-2)"}`}>
                    {pct(m, 1)}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p style="font-size:12.5px;color:var(--ink-3);margin-top:12px;line-height:1.55;max-width:76ch">
      Il margine è quanto le probabilità implicite eccedono il 100%: è la
      commissione, e su questa partita la differenza fra il miglior prezzo e la
      media dei libri è quello che costa non confrontare.
    </p>
  </section>

  <p style="margin-top:28px">
    <a href={`/calcio/${lega.slug}/`}>← torna alla {lega.nome}</a>
  </p>
    </>
  )}

  {/* Le due pagine squadra. Sono il modo in cui chi arriva qui da una ricerca
      trova il resto del sito, e il modo in cui Google arriva a quelle pagine:
      senza questa riga sarebbero duemila pagine partita e quattrocento pagine
      squadra che non si parlano. */}
  <p class="le-squadre">
    <span>Statistiche complete:</span>
