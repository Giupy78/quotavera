---
import Base from "../layouts/Base.astro";
import campionati from "../dati/campionati.json";
import squadre from "../dati/squadre.json";

const num = (v: number, d = 2) =>
  v.toLocaleString("it-IT", { minimumFractionDigits: d, maximumFractionDigits: d });
const pct = (v: number, d = 1) => num(v * 100, d) + "%";

const sq = squadre.campionati as Record<string, any[]>;
const leghe = campionati.campionati;
const totali = leghe.reduce((s, l) => s + l.partite_storico, 0);
---

<Base titolo="Il modello" descrizione="Come sono calcolate le probabilità, e con quali dati.">
  <section>
    <p class="occhiello">Trasparenza</p>
    <div class="hd">
      <h1>Come sono calcolate le probabilità</h1>
      <p>Se non si può spiegare in una pagina, non merita fiducia.</p>
    </div>

    <div class="prosa">
      <p>
        Ogni squadra ha due numeri: quanto segna e quanto subisce. I gol delle
        due squadre sono trattati come due distribuzioni di Poisson quasi
        indipendenti — il «quasi» è la correzione di <strong>Dixon e Coles</strong>,
        che alza 0-0 e 1-1 perché nel calcio vero capitano più spesso di quanto
        due Poisson indipendenti prevedano.
      </p>
      <p>
        Da lì esce <strong>una sola tabella</strong>: la probabilità di ogni
        risultato esatto. Esito finale, over/under e gol/gol non sono stime
        separate, sono somme di celle di quella tabella. È il motivo per cui i
        mercati restano coerenti fra loro senza doverli aggiustare a mano.
      </p>
      <p>
        Le forze si ristimano ogni notte su
        {" "}<strong>{totali.toLocaleString("it-IT")} partite vere</strong> delle ultime
        tre stagioni, pesando meno quelle più vecchie. I dati vengono da
        football-data.co.uk, sono pubblici e gratuiti: chiunque può rifare i
        conti e trovare gli stessi numeri.
      </p>
      <p>
        <strong>Una cosa che va detta e che nessun sito dice.</strong> Abbiamo
        misurato questo modello contro le quote di chiusura del mercato su
        migliaia di partite: <strong>non le batte</strong>. È calibrato — quando
        dice 45%, succede il 45% delle volte — ma il mercato lo sa già. Per
        questo qui non troverai mai un consiglio di gioco: le nostre probabilità
        servono a capire una partita, non a batterne il prezzo.
      </p>
    </div>
  </section>

  <section>
    <div class="hd">
      <h2>Il fattore campo, campionato per campionato</h2>
      <p>
        Stimato dal modello sullo storico. Varia molto più di quanto si creda, e
        chi applica la stessa intuizione ovunque sbaglia sempre nella stessa
        direzione.
      </p>
    </div>
    <div class="scorri">
      <table class="dati">
        <thead>
          <tr>
            <th>Campionato</th>
            <th class="num">Storico</th>
            <th class="num">Fattore campo</th>
            <th class="num">Conversione</th>
          </tr>
        </thead>
        <tbody>
          {
            [...leghe]
              .sort((a, b) => b.vantaggio_casa - a.vantaggio_casa)
              .map((l) => (
                <tr>
                  <td>
                    <a href={`/calcio/${l.slug}/`} style="color:inherit">
                      {l.bandiera} <b>{l.nome}</b>
                    </a>
                    <div style="font-size:11px;color:var(--ink-3)">{l.paese}</div>
                  </td>
                  <td class="num">{l.partite_storico.toLocaleString("it-IT")}</td>
                  <td class="num"><b>{num(Math.exp(l.vantaggio_casa))}×</b></td>
                  <td class="num">{pct(l.conversione)}</td>
                </tr>
              ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <div class="hd">
      <h2>Le squadre, in questa stagione</h2>
      <p>
        La colonna che conta è l'ultima: gol veri contro gol attesi dai tiri in
        porta. Pubblicata perché chiunque possa rifare i conti.
      </p>
    </div>

    {
      leghe.map((l) => (
        <details class="lega-forze" open={l.slug === "serie-a"}>
          <summary>
            <span>{l.bandiera} <b>{l.nome}</b></span>
            <small>
              {(sq[l.slug] ?? []).length} squadre · fattore campo
              {" "}{num(Math.exp(l.vantaggio_casa))}×
            </small>
          </summary>
          <div class="scorri">
            <table class="dati">
              <thead>
                <tr>
                  <th>Squadra</th>
                  <th class="num">Partite</th>
                  <th class="num">Gol fatti</th>
                  <th class="num">Gol subiti</th>
                  <th class="num">Tiri in porta</th>
                  <th class="num">Attesi</th>
                  <th class="num">Segna vs crea</th>
                </tr>
              </thead>
              <tbody>
                {(sq[l.slug] ?? []).map((s: any) => (
                  <tr>
                    <td><b>{s.squadra}</b></td>
                    <td class="num">{s.partite}</td>
                    <td class="num">{s.gol_totali}</td>
                    <td class="num">{num(s.gol_subiti)}</td>
                    <td class="num">{s.in_porta_totali}</td>
                    <td class="num">{num(s.attesi_dai_tiri, 1)}</td>
                    <td
                      class="num"
                      style={`font-weight:600;color:${
                        s.scarto_conversione > 0 ? "var(--s2)" : "var(--s1)"
                      }`}
                    >
                      {s.scarto_conversione >= 0 ? "+" : ""}{num(s.scarto_conversione, 1)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      ))
    }
  </section>
</Base>

<style>
  .lega-forze {
    border: 1px solid var(--rule);
    background: var(--card);
    margin-bottom: 8px;
  }
  .lega-forze summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 12px 18px;
    cursor: pointer;
    font-size: 14px;
    list-style: none;
  }
  .lega-forze summary::-webkit-details-marker { display: none; }
  .lega-forze summary::before { content: "▸"; color: var(--ink-3); margin-right: 4px; }
  .lega-forze[open] summary::before { content: "▾"; }
  .lega-forze[open] summary {
    border-bottom: 1px solid var(--rule);
    background: var(--sunk);
  }
  .lega-forze summary small { color: var(--ink-3); font-size: 12px; }
  .lega-forze .scorri { padding: 4px 18px 14px; }
</style>
