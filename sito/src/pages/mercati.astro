---
import Base from "../layouts/Base.astro";
import campionati from "../dati/campionati.json";
import calendario from "../dati/calendario.json";

const num = (v: number, d = 2) =>
  v.toLocaleString("it-IT", { minimumFractionDigits: d, maximumFractionDigits: d });
const pct = (v: number, d = 1) => num(v * 100, d) + "%";

const cal = calendario.campionati as Record<string, any[]>;

/* Il margine si calcola dalle quote vere delle partite in programma: quello
   del libro di riferimento contro quello del miglior prezzo disponibile.
   La differenza fra i due è quanto costa non confrontare. */
const leghe = campionati.campionati
  .map((c) => {
    const partite = cal[c.slug] ?? [];
    const rif = partite.map((p) => p.margine).filter((m): m is number => m !== null);
    const best = partite
      .map((p) => p.margine_migliore)
      .filter((m): m is number => m !== null);
    const media = (a: number[]) => (a.length ? a.reduce((s, x) => s + x, 0) / a.length : null);
    return {
      ...c,
      partite: partite.length,
      margine: media(rif),
      margine_migliore: media(best),
    };
  })
  .filter((l) => l.margine !== null);

const viste = [
  {
    titolo: "Quanto si tiene il banco",
    sub: "Margine medio sulle partite in programma. È il costo fisso di ogni giocata.",
    valore: (l: any) => l.margine,
    formato: (v: number) => pct(v),
    crescente: true,
    colore: "var(--s2)",
  },
  {
    titolo: "Quanto pesa giocare in casa",
    sub: "Reti attese in più per la squadra di casa, stimato dal modello sullo storico.",
    valore: (l: any) => Math.exp(l.vantaggio_casa),
    formato: (v: number) => num(v) + "×",
    crescente: false,
    colore: "var(--s1)",
  },
  {
    titolo: "Quanti gol si trasformano in rete",
    sub: "Gol per tiro in porta. Dice se un campionato è concreto o dispersivo.",
    valore: (l: any) => l.conversione,
    formato: (v: number) => pct(v),
    crescente: false,
    colore: "var(--s3)",
  },
];

const ordinati = [...leghe].sort((a, b) => (a.margine ?? 1) - (b.margine ?? 1));
const min = ordinati[0];
const max = ordinati[ordinati.length - 1];
---

<Base
  titolo="Confronto fra mercati"
  descrizione="Margine del banco, fattore campo e concretezza, confrontati su 22 campionati."
>
  <section>
    <p class="occhiello">La pagina che serve a scegliere dove guardare</p>
    <div class="hd">
      <h1>Ventidue campionati, ventidue mercati diversi</h1>
      <p>
        Su un campionato il banco si tiene il {pct(min.margine!)}, su un altro il
        {" "}{pct(max.margine!)}: {num(max.margine! / min.margine!, 1)} volte tanto,
        sullo stesso identico tipo di scommessa.
      </p>
    </div>

    <div class="prosa">
      <p>
        È impossibile costruire questa pagina guardando un campionato solo. Le
        differenze fra mercati si vedono solo mettendoli uno accanto all'altro,
        e sono informazione utile prima ancora di aprire una singola partita.
      </p>
    </div>
  </section>

  {
    viste.map((v) => {
      const dati = leghe
        .map((l) => ({ l, x: v.valore(l) }))
        .sort((a, b) => (v.crescente ? a.x - b.x : b.x - a.x));
      const massimo = Math.max(...dati.map((d) => d.x));
      return (
        <section>
          <div class="hd">
            <h2>{v.titolo}</h2>
            <p>{v.sub}</p>
          </div>
          <div class="classifica">
            {dati.map((d) => (
              <a class="riga" href={`/calcio/${d.l.slug}/`}>
                <span class="nome">
                  <i>{d.l.bandiera}</i>
                  {d.l.nome}
                  {!d.l.principale && <em>{d.l.paese}</em>}
                </span>
                <span class="traccia">
                  <span class="riempi" style={`width:${(d.x / massimo) * 100}%;background:${v.colore}`} />
                </span>
                <b class="mono valore">{v.formato(d.x)}</b>
              </a>
            ))}
          </div>
        </section>
      );
    })
  }

  <section>
    <div class="hd">
      <h2>Quanto costa non confrontare</h2>
      <p>
        Il margine del libro di riferimento contro quello che si ottiene
        prendendo il prezzo migliore su ogni esito.
      </p>
    </div>
    <div class="scorri">
      <table class="dati">
        <thead>
          <tr>
            <th>Campionato</th>
            <th class="num">Partite</th>
            <th class="num">Margine riferimento</th>
            <th class="num">Miglior prezzo</th>
            <th class="num">Differenza</th>
          </tr>
        </thead>
        <tbody>
          {
            ordinati.map((l) => (
              <tr>
                <td>
                  <a href={`/calcio/${l.slug}/`} style="color:inherit">
                    {l.bandiera} <b>{l.nome}</b>
                  </a>
                  <div style="font-size:11px;color:var(--ink-3)">{l.paese}</div>
                </td>
                <td class="num">{l.partite}</td>
                <td class="num">{pct(l.margine!)}</td>
                <td class="num" style="color:var(--good)">
                  {l.margine_migliore !== null ? pct(l.margine_migliore) : "—"}
                </td>
                <td class="num" style="font-weight:600">
                  {l.margine_migliore !== null ? pct(l.margine! - l.margine_migliore) : "—"}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p style="font-size:12.5px;color:var(--ink-3);margin-top:12px;line-height:1.55;max-width:76ch">
      L'ultima colonna è la perdita certa di chi gioca senza confrontare: non
      dipende da chi vince la partita, ed è quasi sempre più grande del vantaggio
      che qualunque modello potrebbe procurare. <a href="/quote/">Come funziona →</a>
    </p>
  </section>
</Base>

<style>
  .classifica {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    background: var(--card);
  }
  .riga {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr) 78px;
    gap: 16px;
    align-items: center;
    padding: 9px 18px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
  }
  .riga:last-child { border-bottom: 0; }
  .riga:hover { background: var(--sunk); }
  .nome {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 600;
  }
  .nome i { font-style: normal; font-size: 15px; }
  .nome em {
    font-style: normal;
    font-size: 11px;
    font-weight: 400;
    color: var(--ink-3);
  }
  .traccia { display: block; height: 13px; background: var(--sunk); }
  .riempi { display: block; height: 100%; }
  .valore { text-align: right; font-size: 13.5px; font-weight: 600; }
  @media (max-width: 700px) {
    .riga { grid-template-columns: 1fr 66px; row-gap: 7px; }
    .traccia { grid-column: 1 / -1; order: 3; }
  }
</style>
