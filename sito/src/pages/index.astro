---
import Base from "../layouts/Base.astro";
import RigaPartita from "../components/RigaPartita.astro";
import campionati from "../dati/campionati.json";
import calendario from "../dati/calendario.json";
import articolo from "../dati/articolo.json";

const num = (v: number, d = 2) =>
  v.toLocaleString("it-IT", { minimumFractionDigits: d, maximumFractionDigits: d });
const pct = (v: number, d = 1) => num(v * 100, d) + "%";

const leghe = campionati.campionati;
const perSlug = Object.fromEntries(leghe.map((c) => [c.slug, c]));
const ordine = Object.fromEntries(leghe.map((c, i) => [c.slug, i]));
const cal = calendario.campionati as Record<string, any[]>;

/* Tutte le partite di tutti i campionati, in ordine di orario: è la vista
   che serve la mattina, e che un sito su un campionato solo non può dare. */
const tutte = Object.entries(cal)
  .flatMap(([slug, partite]) => partite.map((p) => ({ ...p, slug })))
  .sort((a, b) => (a.data + a.ora).localeCompare(b.data + b.ora));

const perGiorno = new Map<string, typeof tutte>();
for (const p of tutte) {
  if (!perGiorno.has(p.data)) perGiorno.set(p.data, []);
  perGiorno.get(p.data)!.push(p);
}
/* Il primo giorno si mostra per intero, gli altri in forma compatta.
   La ragione e' misurata, non estetica: elencando ogni partita di ogni
   campionato per quattro giorni, questa pagina era alta **quaranta schermate
   su telefono**. Nessuno arriva in fondo a quaranta schermate, quindi tutto
   quello che stava sotto la seconda era lavoro buttato — e le pagine dei
   campionati hanno gia' tutto, per chi vuole tutto.

   Il sabato si gioca il grosso: 106 partite in diciannove campionati contro
   le 21 di un venerdi'. Per quello i gruppi dei campionati maggiori si aprono
   da soli e gli altri restano chiusi con il conteggio in vista: nessuna
   informazione sparisce, cambia solo quanto costa raggiungerla. */
const tuttiGiorni = [...perGiorno.entries()].slice(0, 6);
const oggi = tuttiGiorni[0];
const prossimi = tuttiGiorni.slice(1);

/* Le partite di un giorno, raccolte per campionato, con i maggiori davanti. */
const perCampionato = (partite: typeof tutte) => {
  const gruppi = new Map<string, typeof partite>();
  for (const p of partite) {
    if (!gruppi.has(p.slug)) gruppi.set(p.slug, []);
    gruppi.get(p.slug)!.push(p);
  }
  /* Maggiori davanti, nell'ordine del catalogo — lo stesso del menu in alto,
     che comincia dalla Serie A. Ordinando per numero di partite, a pari
     conteggio vinceva l'orario, e un venerdi' la Serie A finiva quarta dietro
     Süper Lig ed Eredivisie: corretto, e sbagliato per chi legge in italiano.
     I minori seguono, dal piu' affollato. */
  return [...gruppi.entries()].sort((a, b) => {
    const pa = perSlug[a[0]]?.principale ? 0 : 1;
    const pb = perSlug[b[0]]?.principale ? 0 : 1;
    if (pa !== pb) return pa - pb;
    if (pa === 0) return ordine[a[0]] - ordine[b[0]];
    return b[1].length - a[1].length;
  });
};

const giornoCorto = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("it-IT", {
    weekday: "short", day: "numeric", month: "short",
  });

const dataLunga = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("it-IT", {
    weekday: "long",
    day: "numeric",
    month: "long",
  });
---

<Base
  titolo="Le partite di oggi"
  descrizione="Statistiche, probabilità e quote di 22 campionati europei, aggiornate ogni notte."
>
  <section>
    <p class="occhiello">
      {articolo.partite_in_programma} partite · {articolo.campionati} campionati
    </p>
    <div class="hd">
      <h1>Che partite si giocano, e cosa dicono i numeri</h1>
      <p>
        Le statistiche delle squadre, le probabilità del nostro modello e le
        quote del mercato. Nessun consiglio: i numeri, e l'idea la fai tu.
      </p>
    </div>

    <div class="tessere">
      <div class="tessera">
        <div class="k">Partite in programma</div>
        <div class="v mono">{articolo.partite_in_programma}</div>
        <div class="n">nei prossimi giorni</div>
      </div>
      <div class="tessera">
        <div class="k">Campionati</div>
        <div class="v mono">{articolo.campionati}</div>
        <div class="n">in undici paesi europei</div>
      </div>
      {/* Le quote arrivano solo due o tre giorni prima del fischio: fuori da
          quella finestra queste due tessere restavano "— —", che non e' un
          dato mancante, e' una casella rotta. Meglio una sola tessera che
          dice cosa sta succedendo. */}
      {articolo.partite_meno_care[0] ? (
        <>
          <div class="tessera">
            <div class="k">Margine più basso oggi</div>
            <div class="v mono">{pct(articolo.partite_meno_care[0].margine)}</div>
            <div class="n">
              {articolo.partite_meno_care[0].casa} — {articolo.partite_meno_care[0].ospite}
            </div>
          </div>
          <div class="tessera">
            <div class="k">Margine più alto oggi</div>
            <div class="v mono">{pct(articolo.partite_piu_care[0].margine)}</div>
            <div class="n">
              {articolo.partite_piu_care[0].casa} — {articolo.partite_piu_care[0].ospite}
            </div>
          </div>
        </>
      ) : (
        <div class="tessera larga">
          <div class="k">Quote</div>
          <div class="v mono testo">in arrivo</div>
          <div class="n">
            il mercato le espone due o tre giorni prima; il calendario qui sopra
            arriva più avanti
          </div>
        </div>
      )}
    </div>
  </section>

  <section>
    <div class="hd">
      <h2>Gli spunti</h2>
      <p>
        I numeri che saltano all'occhio oggi. <a href="/blog/">Tutti gli articoli →</a>
      </p>
    </div>

    <div class="duo">
      <div class="pannello">
        <h3>Segnano più di quanto creano</h3>
        <p class="sub">
          Gol veri contro gol attesi dai tiri in porta. Chi sta molto sopra,
          statisticamente, rientra — e il mercato se ne accorge tardi.
        </p>
        <div class="mkt">
          {
            articolo.segnano_piu_di_quanto_creano.map((s: any) => (
              <div>
                <span>
                  {s.bandiera} <b style="font-weight:600">{s.squadra}</b>
                  <small style="display:block;color:var(--ink-3);font-size:11px">
                    {s.gol_totali} gol, {num(s.attesi_dai_tiri, 1)} attesi
                  </small>
                </span>
                <b class="mono" style="color:var(--s2)">+{num(s.scarto_conversione, 1)}</b>
                <span />
              </div>
            ))
          }
        </div>
      </div>

      <div class="pannello">
        <h3>Segnano meno di quanto creano</h3>
        <p class="sub">
          Le squadre che creano e non concretizzano. Sono quelle che il mercato
          sottovaluta più a lungo, perché la classifica non le premia.
        </p>
        <div class="mkt">
          {
            articolo.segnano_meno_di_quanto_creano.map((s: any) => (
              <div>
                <span>
                  {s.bandiera} <b style="font-weight:600">{s.squadra}</b>
                  <small style="display:block;color:var(--ink-3);font-size:11px">
                    {s.gol_totali} gol, {num(s.attesi_dai_tiri, 1)} attesi
                  </small>
                </span>
                <b class="mono" style="color:var(--s1)">{num(s.scarto_conversione, 1)}</b>
                <span />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {
    oggi && (
      <section>
        <div class="hd">
          <h2 style="text-transform:capitalize">{dataLunga(oggi[0])}</h2>
          <p>
            {oggi[1].length} partite in {perCampionato(oggi[1]).length} campionati.
            I gruppi chiusi si aprono con un clic.
          </p>
        </div>
        <div class="giorno">
          {perCampionato(oggi[1]).map(([slug, gruppo]) => (
            <details open={perSlug[slug]?.principale}>
              <summary>
                <span class="bandiera">{perSlug[slug].bandiera}</span>
                <b>{perSlug[slug].nome}</b>
                <span class="conto mono">{gruppo.length}</span>
              </summary>
              <div class="slip">
                {gruppo.map((p) => <RigaPartita p={p} slug={slug} />)}
              </div>
            </details>
          ))}
        </div>
      </section>
    )
  }

  {
    prossimi.length > 0 && (
      <section>
        <div class="hd">
          <h2>Nei prossimi giorni</h2>
          <p>
            Quanto si gioca, e dove. Ogni riquadro porta alla pagina del
            campionato, con calendario completo, classifica e statistiche.
          </p>
        </div>
        <div class="prossimi">
          {prossimi.map(([giorno, partite]) => (
            <div class="giornata">
              <div class="quando">
                <b style="text-transform:capitalize">{giornoCorto(giorno)}</b>
                <span class="mono">{partite.length}</span>
              </div>
              <div class="leghe">
                {perCampionato(partite).map(([slug, gruppo]) => (
                  <a href={`/calcio/${slug}/`} class={perSlug[slug]?.principale ? "forte" : ""}>
                    <span class="bandiera">{perSlug[slug].bandiera}</span>
                    {perSlug[slug].nome}
                    <span class="mono">{gruppo.length}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

</Base>

<style>
  /* --- il giorno in corso, per campionato ---------------------------- */
  .giorno details {
    border: 1px solid var(--rule);
    border-bottom: none;
  }
  .giorno details:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .giorno summary {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px 16px;
    cursor: pointer;
    background: var(--sunk);
    font-size: 13px;
    list-style: none;
  }
  .giorno summary::-webkit-details-marker {
    display: none;
  }
  /* Il triangolino lo disegniamo noi: quello di sistema cambia forma fra
     browser e non si allinea con niente. */
  /* Una freccetta disegnata con due bordi: i caratteri triangolo hanno
     dimensioni diverse in ogni font, e quello piccolo si leggeva a malapena. */
  .giorno summary::before {
    content: "";
    width: 6px;
    height: 6px;
    border-right: 1.5px solid var(--ink-2);
    border-bottom: 1.5px solid var(--ink-2);
    transform: rotate(-45deg);
    margin: 0 4px 0 2px;
    transition: transform 0.15s ease;
    flex: 0 0 auto;
  }
  .giorno details[open] summary::before {
    transform: rotate(45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .giorno summary::before {
      transition: none;
    }
  }
  .giorno summary:hover {
    background: var(--card);
  }
  .giorno summary .conto {
    margin-left: auto;
    color: var(--ink-3);
    font-size: 12px;
  }
  .giorno details[open] summary {
    border-bottom: 1px solid var(--rule);
  }

  /* --- i giorni successivi, in forma compatta ------------------------ */
  .prossimi {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .giornata {
    background: var(--paper);
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 14px;
    padding: 13px 16px;
    align-items: baseline;
  }
  .giornata .quando {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 13px;
  }
  .giornata .quando span {
    color: var(--ink-3);
    font-size: 12px;
  }
  .giornata .leghe {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .giornata .leghe a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border: 1px solid var(--rule);
    font-size: 12px;
    color: var(--ink-2);
    text-decoration: none;
  }
  .giornata .leghe a:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }
  .giornata .leghe a.forte {
    color: var(--ink);
    border-color: var(--rule-strong);
  }
  .giornata .leghe a span.mono {
    color: var(--ink-3);
    font-size: 11px;
  }
  /* La bandiera e' decorativa: su Windows i caratteri bandiera non esistono e
     al loro posto compare la sigla del paese. Tenerla piccola e grigia fa si'
     che in quel caso sembri un'etichetta, non un carattere mancante. */
  .bandiera {
    font-size: 13px;
  }

  @media (max-width: 560px) {
    .giornata {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

  .intestazione-lega a {
    display: block;
    padding: 8px 18px 4px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-decoration: none;
    background: var(--sunk);
    border-bottom: 1px solid var(--rule);
  }
  .intestazione-lega a:hover {
    color: var(--ink);
  }
</style>
