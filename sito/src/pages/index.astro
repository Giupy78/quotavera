---
import Base from "../layouts/Base.astro";
import RigaPartita from "../components/RigaPartita.astro";
import campionati from "../dati/campionati.json";
import calendario from "../dati/calendario.json";
import articolo from "../dati/articolo.json";

const num = (v: number, d = 2) =>
  v.toLocaleString("it-IT", { minimumFractionDigits: d, maximumFractionDigits: d });
const pct = (v: number, d = 1) => num(v * 100, d) + "%";

const leghe = campionati.campionati;
const perSlug = Object.fromEntries(leghe.map((c) => [c.slug, c]));
const cal = calendario.campionati as Record<string, any[]>;

/* Tutte le partite di tutti i campionati, in ordine di orario: è la vista
   che serve la mattina, e che un sito su un campionato solo non può dare. */
const tutte = Object.entries(cal)
  .flatMap(([slug, partite]) => partite.map((p) => ({ ...p, slug })))
  .sort((a, b) => (a.data + a.ora).localeCompare(b.data + b.ora));

const perGiorno = new Map<string, typeof tutte>();
for (const p of tutte) {
  if (!perGiorno.has(p.data)) perGiorno.set(p.data, []);
  perGiorno.get(p.data)!.push(p);
}
const giorni = [...perGiorno.entries()].slice(0, 4);

const dataLunga = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("it-IT", {
    weekday: "long",
    day: "numeric",
    month: "long",
  });
---

<Base
  titolo="Le partite di oggi"
  descrizione="Statistiche, probabilità e quote di 22 campionati europei, aggiornate ogni notte."
>
  <section>
    <p class="occhiello">
      {articolo.partite_in_programma} partite · {articolo.campionati} campionati
    </p>
    <div class="hd">
      <h1>Che partite si giocano, e cosa dicono i numeri</h1>
      <p>
        Le statistiche delle squadre, le probabilità del nostro modello e le
        quote del mercato. Nessun consiglio: i numeri, e l'idea la fai tu.
      </p>
    </div>

    <div class="tessere">
      <div class="tessera">
        <div class="k">Partite in programma</div>
        <div class="v mono">{articolo.partite_in_programma}</div>
        <div class="n">nei prossimi giorni</div>
      </div>
      <div class="tessera">
        <div class="k">Campionati</div>
        <div class="v mono">{articolo.campionati}</div>
        <div class="n">in undici paesi europei</div>
      </div>
      <div class="tessera">
        <div class="k">Margine più basso oggi</div>
        <div class="v mono">
          {articolo.partite_meno_care[0] ? pct(articolo.partite_meno_care[0].margine) : "—"}
        </div>
        <div class="n">
          {articolo.partite_meno_care[0]?.casa} — {articolo.partite_meno_care[0]?.ospite}
        </div>
      </div>
      <div class="tessera">
        <div class="k">Margine più alto oggi</div>
        <div class="v mono">
          {articolo.partite_piu_care[0] ? pct(articolo.partite_piu_care[0].margine) : "—"}
        </div>
        <div class="n">
          {articolo.partite_piu_care[0]?.casa} — {articolo.partite_piu_care[0]?.ospite}
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="hd">
      <h2>Gli spunti</h2>
      <p>
        I numeri che saltano all'occhio oggi. <a href="/blog/">Tutti gli articoli →</a>
      </p>
    </div>

    <div class="duo">
      <div class="pannello">
        <h3>Segnano più di quanto creano</h3>
        <p class="sub">
          Gol veri contro gol attesi dai tiri in porta. Chi sta molto sopra,
          statisticamente, rientra — e il mercato se ne accorge tardi.
        </p>
        <div class="mkt">
          {
            articolo.segnano_piu_di_quanto_creano.map((s: any) => (
              <div>
                <span>
                  {s.bandiera} <b style="font-weight:600">{s.squadra}</b>
                  <small style="display:block;color:var(--ink-3);font-size:11px">
                    {s.gol_totali} gol, {num(s.attesi_dai_tiri, 1)} attesi
                  </small>
                </span>
                <b class="mono" style="color:var(--s2)">+{num(s.scarto_conversione, 1)}</b>
                <span />
              </div>
            ))
          }
        </div>
      </div>

      <div class="pannello">
        <h3>Segnano meno di quanto creano</h3>
        <p class="sub">
          Le squadre che creano e non concretizzano. Sono quelle che il mercato
          sottovaluta più a lungo, perché la classifica non le premia.
        </p>
        <div class="mkt">
          {
            articolo.segnano_meno_di_quanto_creano.map((s: any) => (
              <div>
                <span>
                  {s.bandiera} <b style="font-weight:600">{s.squadra}</b>
                  <small style="display:block;color:var(--ink-3);font-size:11px">
                    {s.gol_totali} gol, {num(s.attesi_dai_tiri, 1)} attesi
                  </small>
                </span>
                <b class="mono" style="color:var(--s1)">{num(s.scarto_conversione, 1)}</b>
                <span />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {
    giorni.map(([giorno, partite]) => {
      /* Raggruppate per campionato dentro la giornata: l'etichetta compare
         una volta per gruppo. Farlo in CSS sembrava più furbo ma mostrava
         l'intestazione su ogni riga tranne la prima, che è un'altra cosa. */
      const gruppi = new Map<string, typeof partite>();
      for (const p of partite) {
        if (!gruppi.has(p.slug)) gruppi.set(p.slug, []);
        gruppi.get(p.slug)!.push(p);
      }
      return (
        <section>
          <div class="hd">
            <h2 style="text-transform:capitalize">{dataLunga(giorno)}</h2>
            <p>{partite.length} partite</p>
          </div>
          <div class="slip">
            {[...gruppi.entries()].map(([slug, gruppo]) => (
              <>
                <div class="intestazione-lega">
                  <a href={`/calcio/${slug}/`}>
                    {perSlug[slug].bandiera} {perSlug[slug].nome}
                  </a>
                </div>
                {gruppo.map((p) => (
                  <RigaPartita p={p} slug={slug} />
                ))}
              </>
            ))}
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  .intestazione-lega a {
    display: block;
    padding: 8px 18px 4px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-decoration: none;
    background: var(--sunk);
    border-bottom: 1px solid var(--rule);
  }
  .intestazione-lega a:hover {
    color: var(--ink);
  }
</style>
