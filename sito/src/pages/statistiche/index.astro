---
import Base from "../../layouts/Base.astro";
import fra from "../../dati/fra_campionati.json";

/* L'indice degli articoli con i dati. Oggi ce n'e' uno; la sezione esiste lo
   stesso perche' l'indirizzo dell'articolo la nomina, e chi accorcia l'URL
   deve trovare una pagina, non un 404. Ogni voce ha una riga con il dato
   principale, preso dallo stesso file dell'articolo: l'indice non promette
   niente che la pagina non dica. */

const righe = fra.campionati as any[];
const num = (v: number, d = 2) =>
  v.toLocaleString("it-IT", { minimumFractionDigits: d, maximumFractionDigits: d });
const art = (nome: string) =>
  nome.startsWith("La") ? "" : /^[aeiouAEIOU]/.test(nome) ? "l'" : "la ";
const primo = righe[0];
const serieA = righe.find((r) => r.slug === "serie-a");

const articoli = [
  {
    href: "/statistiche/campionati-con-piu-gol/",
    titolo: "I campionati con più gol in Europa",
    sintesi:
      `In testa ${art(primo.nome)}${primo.nome} con ${num(primo.totale.gol)} gol a partita` +
      (serieA ? `; la Serie A è ${serieA.posizione_gol}ª su ${righe.length}.` : "."),
  },
];
---

<Base
  titolo="Statistiche fra campionati europei"
  descrizione="Ventidue campionati europei messi a confronto su gol, fattore campo e altri numeri, su stagioni intere. Aggiornati ogni notte."
>
  <section>
    <div class="hd">
      <h1>Statistiche fra campionati</h1>
      <p>
        Ventidue campionati messi uno accanto all'altro, su stagioni intere. Sono i confronti
        che non si possono fare guardando un campionato alla volta.
      </p>
    </div>

    <ul class="elenco">
      {
        articoli.map((a) => (
          <li>
            <a href={a.href}>
              <b>{a.titolo}</b>
              <span>{a.sintesi}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .elenco {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .elenco li {
    border-bottom: 1px solid var(--rule);
  }
  .elenco a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0;
    color: inherit;
    text-decoration: none;
  }
  .elenco b {
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--ink);
  }
  .elenco a:hover b {
    color: var(--s1);
  }
  .elenco span {
    font-size: 13.5px;
    color: var(--ink-2);
  }
</style>
