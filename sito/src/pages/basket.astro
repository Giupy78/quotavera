---
import Base from "../layouts/Base.astro";
import basket from "../dati/basket.json";

const num = (v: number, d = 1) =>
  v.toLocaleString("it-IT", { minimumFractionDigits: d, maximumFractionDigits: d });
const pct = (v: number) => num(v * 100, 1) + "%";
---

<Base titolo="Basket" descrizione="Margine e totale attesi, dal modello normale.">
  <section>
    <p class="occhiello">{basket.campionato} · giornata simulata</p>
    <div class="hd">
      <h1>Basket</h1>
      <p>
        Cento possessi per parte: il margine finale è ben approssimato da una
        normale, e la matrice dei punteggi esatti non serve a nessuno.
      </p>
    </div>

    <div class="scorri">
      <table class="dati">
        <thead>
          <tr>
            <th>Partita</th>
            <th class="num">Punti attesi</th>
            <th class="num">Margine</th>
            <th class="num">Totale</th>
            <th class="num">Vittoria casa</th>
          </tr>
        </thead>
        <tbody>
          {
            basket.partite.map((p) => (
              <tr>
                <td><b>{p.casa} — {p.ospite}</b></td>
                <td class="num">{num(p.punti_casa)} – {num(p.punti_ospite)}</td>
                <td class="num">{p.margine_atteso >= 0 ? "+" : ""}{num(p.margine_atteso)}</td>
                <td class="num">{num(p.totale_atteso)}</td>
                <td class="num"><b>{pct(p.p_casa)}</b></td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <div class="hd">
      <h2>Forza e ritmo</h2>
      <p>
        Due regressioni separate, con regolarizzazioni diverse: il ritmo ha
        segnale più debole a parità di rumore e va tirato verso la media più
        della forza.
      </p>
    </div>
    <div class="scorri">
      <table class="dati">
        <thead>
          <tr>
            <th>Squadra</th>
            <th class="num">Forza (punti)</th>
            <th class="num">Ritmo (punti sul totale)</th>
          </tr>
        </thead>
        <tbody>
          {
            basket.forze.map((s) => (
              <tr>
                <td><b>{s.squadra}</b></td>
                <td class="num" style={s.forza >= 0 ? "color:var(--good)" : undefined}>
                  {s.forza >= 0 ? "+" : ""}{num(s.forza)}
                </td>
                <td class="num" style="color:var(--ink-3)">
                  {s.ritmo >= 0 ? "+" : ""}{num(s.ritmo)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>
