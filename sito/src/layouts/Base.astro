---
import "../styles/global.css";
import campionati from "../dati/campionati.json";

interface Props {
  titolo: string;
  descrizione?: string;
}

const PREDEFINITA =
  "Statistiche, probabilità e quote di 22 campionati europei, aggiornate ogni notte. Nessun consiglio di gioco: i numeri, e l'idea la fai tu.";

const { titolo, descrizione = PREDEFINITA } = Astro.props;
const qui = Astro.url.pathname;
const canonico = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const titoloCompleto = `${titolo} — Quota Vera`;

const voci = [
  { href: "/", testo: "Oggi" },
  { href: "/blog/", testo: "Articoli" },
  { href: "/mercati/", testo: "Mercati" },
  { href: "/quote/", testo: "Come si leggono" },
  { href: "/modello/", testo: "Il modello" },
  { href: "/track-record/", testo: "Track record" },
  { href: "/cosa-facciamo/", testo: "Cos'è" },
];

const attiva = (href: string) =>
  href === "/" ? qui === "/" : qui.startsWith(href);

const principali = campionati.campionati.filter((c) => c.principale);
const generato = new Date(campionati.generato_il);
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={canonico} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Anteprima quando qualcuno incolla un link su WhatsApp o sui social:
        senza questi tag comparirebbe solo l'indirizzo nudo. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Quota Vera" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={canonico} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={titoloCompleto} />
    <meta name="twitter:description" content={descrizione} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
    />
    {import.meta.env.PUBLIC_INDICIZZA !== "1" && (
      <meta name="robots" content="noindex, nofollow" />
    )}
  </head>
  <body>
    <div class="board">
      <div class="wrap">
        <div class="topbar">
          <a class="marchio" href="/">Quota <em>Vera</em></a>
          <nav class="menu">
            {
              voci.map((v) => (
                <a href={v.href} aria-current={attiva(v.href) ? "page" : undefined}>
                  {v.testo}
                </a>
              ))
            }
          </nav>
        </div>
        <nav class="leghe-nav">
          {
            principali.map((c) => (
              <a
                href={`/calcio/${c.slug}/`}
                aria-current={qui.startsWith(`/calcio/${c.slug}/`) ? "page" : undefined}
              >
                <span>{c.bandiera}</span>
                {c.nome}
              </a>
            ))
          }
          <a href="/campionati/" class="tutti">tutti i 22 →</a>
        </nav>
      </div>
    </div>

    <main class="wrap">
      <slot />
    </main>

    <div class="wrap">
      <footer>
        <p>
          Statistiche e quote da <b>football-data.co.uk</b>. Ultimo aggiornamento
          {" "}<time datetime={campionati.generato_il}>
            {generato.toLocaleString("it-IT", { dateStyle: "long", timeStyle: "short" })}
          </time>.
        </p>
        <p>
          Quota Vera pubblica statistiche e probabilità calcolate da un modello
          pubblico. <b>Non dà consigli di gioco e non contiene collegamenti a
          operatori.</b> È un servizio informativo di analisi e comparazione —
          <a href="/cosa-facciamo/">cos'è questo sito</a>.
        </p>
        <p>
          Se giocare è diventato un problema: <b>800 940 789</b>, Numero Verde
          Nazionale Dipendenze, anonimo e gratuito.
        </p>
      </footer>
    </div>
  </body>
</html>

<style>
  .leghe-nav {
    display: flex;
    gap: 2px;
    flex-wrap: wrap;
    padding-bottom: 14px;
  }
  .leghe-nav a {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--board-ink-2);
    text-decoration: none;
    font-size: 12.5px;
    padding: 6px 10px;
    border: 1px solid transparent;
  }
  .leghe-nav a:hover {
    color: var(--board-ink);
    border-color: var(--board-rule);
  }
  .leghe-nav a[aria-current="page"] {
    color: var(--board-ink);
    border-color: var(--board-rule);
    background: rgba(255, 255, 255, 0.04);
  }
  .leghe-nav a span {
    font-size: 14px;
  }
  .leghe-nav .tutti {
    color: var(--s1);
  }
</style>
